{% extends 'base.html.twig' %}
{% block title %}{{ room ? 'Forumraum bearbeiten' : 'Forumraum erstellen' }}{% endblock %}
{% block body %}
<main class="dashboard">
    <p><a href="{{ path('app_admin_gaming_forum_rooms') }}">Zur Forumverwaltung</a></p>
    <h1>{{ room ? 'Forumraum bearbeiten' : 'Forumraum erstellen' }}</h1>
    {% if error %}<p role="alert" class="notice notice-error">{{ error }}</p>{% endif %}
    <form method="post">
        <input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
        <label for="forum-room-title">Name</label>
        <input id="forum-room-title" name="title" maxlength="180" value="{{ title }}" required>
        <label for="forum-room-visibility">Sichtbarkeit</label>
        <select id="forum-room-visibility" name="visibility" required>
            <option value="public" {{ visibility == 'public' ? 'selected' : '' }}>Öffentlich</option>
            <option value="members" {{ visibility == 'members' ? 'selected' : '' }}>Angemeldete Mitglieder</option>
            <option value="guild" {{ visibility == 'guild' ? 'selected' : '' }}>Eine Gilde</option>
            <option value="moderators" {{ visibility == 'moderators' ? 'selected' : '' }}>Moderationsteam</option>
        </select>
        <label for="forum-room-guild">Gilde für einen Gildenraum</label>
        <select id="forum-room-guild" name="guild_id">
            <option value="">Keine Gilde</option>
            {% for guild in guilds %}
                <option value="{{ guild.id }}" {{ selectedGuildId is not null and selectedGuildId == guild.id ? 'selected' : '' }}>{{ guild.name }}</option>
            {% endfor %}
        </select>
        <button type="submit">Speichern</button>
    </form>
</main>
{% endblock %}
