{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}Meine Gildentermine | {{ site.siteName }}{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_guild_portal_index') }}">Mein Gildenbereich</a>
    <nav class="top-actions">
        <a href="{{ path('app_account_security') }}">Kontosicherheit</a>
        <form method="post" action="{{ path('app_logout') }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
            <button class="button-secondary">Abmelden</button>
        </form>
    </nav>
</header>
<main class="dashboard">
    <p class="eyebrow">Geschützter Mitgliederbereich</p>
    <h1>Meine kommenden Gildentermine</h1>
    {% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}
    <p class="muted">Du siehst hier nur künftige Anmeldungen deiner aktiven Charaktere.</p>
    <div class="application-list">
        {% for signup in signups %}
            <article class="application-card">
                <div>
                    <p class="eyebrow">{{ signup.guildName }} · {{ signup.characterName }} · {{ signup.startsAt|date('d.m.Y H:i') }}</p>
                    <h2>{{ signup.eventTitle }}</h2>
                    <p>Antwort: {% if signup.response == 'going' %}Zusage{% elseif signup.response == 'maybe' %}Vielleicht{% else %}Warteliste{% endif %} · Rolle: {{ signup.role }}</p>
                </div>
                <form method="post" action="{{ path('app_guild_event_signup_portal_withdraw', {signupId: signup.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('guild-event-signup-withdraw-' ~ signup.id) }}">
                    <button class="button-secondary">Anmeldung zurückziehen</button>
                </form>
            </article>
        {% else %}
            <article class="panel">
                <h2>Keine kommenden Anmeldungen</h2>
                <p>Deine künftigen Zusagen, Vielleicht-Antworten und Wartelistenplätze werden hier angezeigt.</p>
            </article>
        {% endfor %}
    </div>
    {% if lastPage > 1 %}
        <nav class="pagination" aria-label="Seiten">
            {% if page > 1 %}<a href="{{ path('app_guild_event_signup_portal_index', {page: page - 1}) }}">Zurück</a>{% endif %}
            <span>Seite {{ page }} von {{ lastPage }}</span>
            {% if page < lastPage %}<a href="{{ path('app_guild_event_signup_portal_index', {page: page + 1}) }}">Weiter</a>{% endif %}
        </nav>
    {% endif %}
    <p class="muted">{{ total }} kommende Anmeldungen</p>
</main>
{% endblock %}
