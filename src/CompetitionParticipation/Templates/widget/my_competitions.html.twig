<section class="portal-card" aria-labelledby="my-competition-entries-title">
    <h2 id="my-competition-entries-title">Meine Competitions</h2>
    {% if not data.authenticated %}
        <p><a href="{{ path('app_login') }}">Melde dich an, um deine Competition-Anmeldungen zu sehen.</a></p>
    {% elseif data.entries is empty %}
        <p>Du hast noch keine Competition-Anmeldungen.</p>
        <a href="{{ path('app_competition_index') }}">Competitions ansehen</a>
    {% else %}
        <p>Aktive Anmeldungen: {{ data.activeCount }}</p>
        <ul>
            {% for participant in data.entries %}
                {% if participant.active %}
                    <li><a href="{{ path('app_competition_show', {id: participant.competition.id}) }}">{{ participant.competition.name }}</a> · {{ participant.name }}</li>
                {% endif %}
            {% endfor %}
        </ul>
        <a href="{{ path('app_competition_participation_dashboard') }}">Anmeldungen verwalten</a>
    {% endif %}
</section>
