<form class="video-search-widget" action="{{ path('app_video_search') }}" method="get" role="search">
    <label for="video-search-{{ widget.id }}">Videos durchsuchen</label>
    <div class="video-search-controls">
        <input id="video-search-{{ widget.id }}" type="search" name="q" minlength="2" maxlength="100" required>
        <button type="submit">Suchen</button>
    </div>
</form>
