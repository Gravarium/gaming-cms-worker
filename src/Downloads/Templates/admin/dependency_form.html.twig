{% extends 'base.html.twig' %}
{% block title %}Abhängigkeit hinzufügen{% endblock %}
{% block body %}
<main class="content-shell">
    <nav><a href="{{ path('app_admin_download_relations_version', {version: version.id}) }}">Zurück zur Version</a></nav>
    <h1>Abhängigkeit hinzufügen</h1>
    <p>{{ version.package.title }} · Version {{ version.version }}</p>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.targetPackage) }}
        {{ form_row(form.kind) }}
        {{ form_row(form.constraintExpression) }}
        {{ form_row(form.submit) }}
    {{ form_end(form) }}
</main>
{% endblock %}
