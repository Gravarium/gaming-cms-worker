APP_ENV=dev
APP_SECRET=worker-development-only
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost
DATABASE_URL="sqlite:///%kernel.project_dir%/var/worker.db"
MESSENGER_TRANSPORT_DSN=sync://
MAILER_DSN=null://null
MAIL_FROM_ADDRESS=noreply@example.invalid
MEDIA_MALWARE_SCAN_MODE=off
MEDIA_CLAMDSCAN_BIN=/usr/bin/clamdscan
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
MEDIA_S3_CONFIG_FILE=/dev/null
WEBAUTHN_ALLOWED_ORIGIN=http://localhost
WEBAUTHN_RELYING_PARTY_ID=localhost
BACKUP_ROOT=var/worker-backups
OFFSITE_TARGETS_FILE=/dev/null
EXTERNAL_CONNECTOR_CONFIG_FILE=/dev/null
