{% extends 'base.html.twig' %}

{% block title %}Neue Unterhaltung{% endblock %}

{% block body %}
<main>
    <h1>Neue Unterhaltung</h1>
    {{ form_start(form) }}
        {{ form_errors(form) }}
        {% if not hasRecipientChoices %}
            <p class="muted" role="status">Zurzeit gibt es keine aktiven Mitglieder mit einem für dich sichtbaren Anzeigenamen.</p>
        {% endif %}
        {{ form_row(form.recipientIds) }}
        {{ form_row(form.title) }}
        <button type="submit" {% if not hasRecipientChoices %}disabled{% endif %}>Erstellen</button>
    {{ form_end(form) }}
    <p><a href="{{ path('app_social_index') }}">Zurück zu Social</a></p>
</main>
{% endblock %}
