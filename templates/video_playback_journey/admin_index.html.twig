{% extends 'video_playback_journey/layout.html.twig' %}{% block heading %}Videoquellen prüfen & Vorschau{% endblock %}{% block journey %}
<p>Prüfe unterstützte Formate und Freigaben. Die tatsächliche Erreichbarkeit und Wiedergabe testest du anschließend in der Vorschau.</p><a href="{{ path('app_admin_video_workspace') }}">Quellen, Creator & Live verwalten</a>
<div class="journey-grid">{% for video in videos %}<section class="panel"><h2>{{ video.title }}</h2><p>{{ video.published ? 'Veröffentlicht' : 'Nicht veröffentlicht' }}</p><a href="{{ path('app_admin_video_playback_check_video', {id:video.id}) }}">Prüfen & Vorschau öffnen</a></section>{% else %}<p>Keine Videos vorhanden.</p>{% endfor %}</div>
<nav aria-label="Videoseiten">{% if page > 1 %}<a href="{{ path('app_admin_video_playback_check', {page:page - 1}) }}">Vorherige Seite</a>{% endif %}{% if more %}<a href="{{ path('app_admin_video_playback_check', {page:page + 1}) }}">Nächste Seite</a>{% endif %}</nav>{% endblock %}
