{% extends 'video_playback_journey/layout.html.twig' %}{% block heading %}Quellenprüfung: {{ video.title }}{% endblock %}{% block journey %}
<section class="panel"><h2>Veröffentlichung</h2><p>{{ video.published ? 'Video veröffentlicht.' : 'Video noch nicht veröffentlicht oder deaktiviert. Die Vorschau veröffentlicht es nicht.' }}</p><p>{{ publicVisible ? 'Für Besucher ohne Anmeldung sichtbar.' : 'Für Besucher ohne Anmeldung nicht sichtbar. Veröffentlichung, Auffindbarkeit und Creator-Sichtbarkeit prüfen.' }}</p>
<div class="journey-actions"><a href="{{ path('app_admin_video_workspace_source_new', {video:video.id}) }}">Quelle hinzufügen</a><a href="{{ path('app_admin_video_workspace_metadata', {id:video.id}) }}">Sichtbarkeit bearbeiten</a><a href="{{ path('app_admin_video_workspace') }}">Quellenverwaltung</a></div></section>
<p>Die Prüfung bestätigt nur Format und CMS-Freigabe. Erst „Vorschau laden“ verbindet deinen Browser mit dem Anbieter. CORS, Login, Regionen oder Einbettungsverbote können die Wiedergabe verhindern.</p>
<div class="journey-grid">{% for row in rows %}<section class="panel"><h2>{{ row.label }}</h2>{% if row.issue %}<p>{{ row.issue }}</p>{% else %}<p>Format unterstützt; Freigabe zur Vorschau vorhanden.</p>{% endif %}{% if row.edit %}<a href="{{ path('app_admin_video_workspace_source_edit', {id:row.edit}) }}">Quelle bearbeiten</a>{% endif %}{% if row.engines %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('video-check-' ~ video.id) }}"><input type="hidden" name="source" value="{{ row.id }}"><label>Player <select name="engine">{% for key,label in row.engines %}<option value="{{ key }}">{{ label }}</option>{% endfor %}</select></label><button>Vorschau laden</button></form>{% endif %}</section>{% endfor %}</div>
{% include 'video_playback_journey/player.html.twig' with {title:video.title,resumeKey:'',showResumeNotice:false} %}
<script type="module" src="{{ asset('video_playback_journey/journey.js') }}"></script>
{% endblock %}
