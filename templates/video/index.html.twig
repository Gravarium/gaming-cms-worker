{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}Videos | {{ site.siteName }}{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_home') }}">{% if site.logoPath %}<img class="site-logo" src="{{ site.logoPath }}" alt="{{ site.siteName }}">{% else %}{{ site.siteName }}{% endif %}</a>
    <nav class="top-actions"><a href="{{ path('app_news_index') }}">News</a>{% if cms_module_enabled('gaming') %}<a href="{{ path('app_gaming_index') }}">Gaming</a>{% endif %}</nav>
</header>
<main class="public-shell video-library">
    <p class="eyebrow">Mediathek</p>
    <h1>Videos</h1>
    <p class="hero-copy">Streams, Guides, Highlights und Community-Videos an einem Ort.</p>

    <div class="video-filters">
        <a class="status {{ not activeCategory and not activePlaylist ? 'status-ready' : '' }}" href="{{ path('app_video_index') }}">Alle Videos</a>
        {% for category in categories %}<a class="status {{ activeCategory and activeCategory.id == category.id ? 'status-ready' : '' }}" href="{{ path('app_video_index', {category: category.slug}) }}">{{ category.name }}</a>{% endfor %}
        {% for playlist in playlists %}<a class="status {{ activePlaylist and activePlaylist.id == playlist.id ? 'status-ready' : '' }}" href="{{ path('app_video_index', {playlist: playlist.slug}) }}">Playlist: {{ playlist.title }}</a>{% endfor %}
    </div>

    {% if activeCategory %}<div class="video-selection"><h2>{{ activeCategory.name }}</h2>{% if activeCategory.description %}<p>{{ activeCategory.description }}</p>{% endif %}</div>{% endif %}
    {% if activePlaylist %}<div class="video-selection"><h2>{{ activePlaylist.title }}</h2>{% if activePlaylist.description %}<p>{{ activePlaylist.description }}</p>{% endif %}</div>{% endif %}

    <section class="video-grid">
        {% for video in videos %}
            <article class="video-card {{ video.featured ? 'video-card-featured' : '' }}">
                <a class="video-thumbnail" href="{{ path('app_video_show', {slug: video.slug}) }}">
                    {% if video.thumbnailUrl %}<img src="{{ video.thumbnailUrl }}" alt="{{ video.title }}" loading="lazy">
                    {% else %}<span class="video-play-symbol">▶</span>{% endif %}
                    {% if video.durationLabel %}<span class="video-duration">{{ video.durationLabel }}</span>{% endif %}
                </a>
                <div class="video-card-body">
                    <p class="eyebrow">{{ video.category and video.category.enabled ? video.category.name : video.sourceType|capitalize }}</p>
                    <h2><a href="{{ path('app_video_show', {slug: video.slug}) }}">{{ video.title }}</a></h2>
                    <p>{{ video.description|striptags|slice(0, 180) }}{% if video.description|length > 180 %}…{% endif %}</p>
                    <span class="video-date">{{ video.publishedAt|date('d.m.Y H:i') }} Uhr</span>
                </div>
            </article>
        {% else %}
            <div class="panel"><h2>Noch keine Videos</h2><p>In diesem Bereich wurden noch keine veröffentlichten Videos gefunden.</p></div>
        {% endfor %}
    </section>
</main>
{% endblock %}
