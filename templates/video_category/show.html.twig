{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}{{ category.name }} | Videos | {{ site.siteName }}{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_home') }}">{% if site.logoPath %}<img class="site-logo" src="{{ site.logoPath }}" alt="{{ site.siteName }}">{% else %}{{ site.siteName }}{% endif %}</a>
    <nav class="top-actions"><a class="button-link button-secondary" href="{{ path('app_video_category_index') }}">Alle Kategorien</a><a class="button-link button-secondary" href="{{ path('app_video_index') }}">Alle Videos</a></nav>
</header>
<main class="public-shell video-library">
    <p class="eyebrow">Videokategorie</p>
    <h1>{{ category.name }}</h1>
    {% if category.description %}<p class="hero-copy">{{ category.description }}</p>{% endif %}

    <section class="video-grid" aria-label="Videos in dieser Kategorie">
        {% for video in videos %}
            <article class="video-card {{ video.featured ? 'video-card-featured' : '' }}">
                <a class="video-thumbnail" href="{{ path('app_video_show', {slug: video.slug}) }}">
                    {% if video.thumbnailUrl %}<img src="{{ video.thumbnailUrl }}" alt="{{ video.title }}" loading="lazy">
                    {% else %}<span class="video-play-symbol">▶</span>{% endif %}
                    {% if video.durationLabel %}<span class="video-duration">{{ video.durationLabel }}</span>{% endif %}
                </a>
                <div class="video-card-body">
                    <p class="eyebrow">{{ category.name }}</p>
                    <h2><a href="{{ path('app_video_show', {slug: video.slug}) }}">{{ video.title }}</a></h2>
                    <p>{{ video.description|striptags|slice(0, 180) }}{% if video.description|length > 180 %}…{% endif %}</p>
                    <span class="video-date">{{ video.publishedAt|date('d.m.Y H:i') }} Uhr</span>
                </div>
            </article>
        {% else %}
            <div class="panel">
                <h2>Noch keine veröffentlichten Videos</h2>
                <p>In dieser Kategorie wurden noch keine Videos veröffentlicht.</p>
            </div>
        {% endfor %}
    </section>
</main>
{% endblock %}
