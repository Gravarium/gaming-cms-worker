{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}Passwort zurücksetzen | {{ site.siteName }}{% endblock %}
{% block body %}
<main class="auth-shell"><section class="auth-card">
    <p class="eyebrow">Kontowiederherstellung</p><h1>Neues Passwort festlegen</h1>
    {% if invalid %}<div class="alert">Dieser Link ist ungültig, abgelaufen oder wurde bereits verwendet.</div><a class="button-link" href="{{ path('app_forgot_password') }}">Neuen Link anfordern</a>
    {% else %}{{ form_start(form, {attr: {class: 'form-stack'}}) }}{{ form_widget(form) }}<button>Passwort speichern</button>{{ form_end(form) }}{% endif %}
</section></main>
{% endblock %}
