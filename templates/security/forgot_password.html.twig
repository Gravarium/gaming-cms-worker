{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}Passwort vergessen | {{ site.siteName }}{% endblock %}
{% block body %}
<main class="auth-shell"><section class="auth-card">
    <p class="eyebrow">Kontowiederherstellung</p><h1>Passwort vergessen</h1>
    <p class="muted">Wenn ein aktives Konto zu dieser Adresse existiert, senden wir einen Link. Der Link ist eine Stunde gültig.</p>
    {% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}
    {{ form_start(form, {attr: {class: 'form-stack'}}) }}{{ form_widget(form) }}<button>Link anfordern</button>{{ form_end(form) }}
    <a class="back-link" href="{{ path('app_login') }}">Zurück zur Anmeldung</a>
</section></main>
{% endblock %}
