<div class="portal-cards">{% for item in data.items %}<article class="portal-card"><div class="portal-card-art video-art" aria-hidden="true"><span>▶</span></div><div class="portal-card-copy"><p class="portal-kicker">VIDEO {{ item.durationLabel ?: '' }}</p><h3><a href="{{ path('app_video_show',{slug:item.slug}) }}">{{ item.title }}</a></h3><a class="portal-read" href="{{ path('app_video_show',{slug:item.slug}) }}">Video ansehen ↗</a></div></article>{% else %}<p class="portal-empty">Noch keine veröffentlichten Videos.</p>{% endfor %}</div>
