<div class="portal-hero-art" aria-hidden="true">{% if data.image|default(null) %}<img src="{{ data.image.url }}" alt="">{% endif %}</div><div class="portal-hero-copy"><p class="portal-kicker">{{ site.description ?: 'Gemeinsam neue Welten entdecken' }}</p><h1>{{ config.title ?: site.homeTitle }}</h1><p>{{ config.text ?: site.homeText }}</p><div class="portal-actions">{% if cms_module_enabled('content') %}<a class="portal-button" href="{{ path('app_news_index') }}">News ansehen <span aria-hidden="true">↗</span></a>{% endif %}{% if cms_module_enabled('gaming') %}<a class="portal-button secondary" href="{{ path('app_gaming_index') }}">Gilden entdecken</a>{% endif %}{% if cms_module_enabled('video') %}<a class="portal-button secondary" href="{{ path('app_video_index') }}">Videos ansehen</a>{% endif %}</div><div class="portal-hero-rule"><span>DEIN PORTAL</span><span>DEINE GESCHICHTE</span></div></div>
