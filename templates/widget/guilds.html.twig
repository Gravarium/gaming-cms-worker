<div class="portal-cards">{% for item in data.items %}<article class="portal-card guild-card"><div class="guild-emblem" aria-hidden="true">{{ item.name|slice(0,1)|upper }}</div><div class="portal-card-copy"><p class="portal-kicker">{{ item.game.name }}</p><h3><a href="{{ path('app_guild_show',{slug:item.slug}) }}">{{ item.name }}</a></h3><p>{{ item.serverName }}</p>{% if item.recruitmentOpen %}<span class="portal-tag">Sucht Mitglieder</span>{% endif %}</div></article>{% else %}<p class="portal-empty">Aktuell keine passenden Gilden.</p>{% endfor %}</div>
