<div class="public-competition-brackets">
    {% for competition in competitions %}
        <article class="public-competition-bracket-card">
            <h3>{{ competition.name }}</h3>
            {% if competition.game %}
                <p>{{ competition.game.name }} · {{ competition.startsAt|date('d.m.Y') }}</p>
            {% endif %}
            <a href="{{ path('app_competition_bracket', {id: competition.id}) }}">Bracket ansehen</a>
        </article>
    {% else %}
        <p>Aktuell gibt es keine öffentlichen Turniere mit Paarungen.</p>
    {% endfor %}
</div>
