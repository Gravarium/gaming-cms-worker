{% extends 'video_player_choice/layout.html.twig' %}{% block heading %}{{ title }}{% endblock %}
{% block choice %}
<p>Quelle und Player werden erst nach „Auswählen und laden“ gestartet. Dabei wird eine Verbindung zum Videoanbieter hergestellt.</p>
<div class="choice-sources">{% for source in sources %}<section class="panel"><h2>{{ source.label }}</h2>{% if source.engines %}
<form method="post" data-choice-form><input type="hidden" name="_token" value="{{ csrf_token('player-choice-' ~ identity) }}"><input type="hidden" name="source" value="{{ source.id }}">
<label>Player <select name="engine" data-engine>{% for key, label in source.engines %}<option value="{{ key }}"{% if selected == source.id and engine == key %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>
{% if 'native' in source.engines|keys or 'youtube' in source.engines|keys %}<details><summary>Wiedergabe einstellen</summary><div class="choice-settings">
<label>Startzeit in Sekunden <input name="start" type="number" min="0" max="86400" step="1" value="{{ selected == source.id and options ? options.start : 0 }}"></label>
{% if 'native' in source.engines|keys %}<label>Geschwindigkeit <select name="speed">{% for rate in ['0.5','0.75','1','1.25','1.5','2'] %}<option value="{{ rate }}"{% if selected == source.id and options ? options.speed == rate : rate == '1' %} selected{% endif %}>{{ rate }}×</option>{% endfor %}</select></label>{% endif %}
<label><input type="checkbox" name="muted" value="1"{% if selected == source.id and options and options.muted %} checked{% endif %}> Stumm starten</label>
<label><input type="checkbox" name="loop" value="1"{% if selected == source.id and options and options.loop %} checked{% endif %}> Wiederholen</label>
<label><input type="checkbox" name="autoplay" value="1"{% if selected == source.id and options and options.autoplay %} checked{% endif %}> Nach dem Laden starten (Browser kann dies blockieren)</label>
{% if 'youtube' in source.engines|keys %}<p>Diese Einstellungen wirken bei „YouTube mit Einstellungen“.</p><label><input type="checkbox" name="captions" value="1"{% if selected == source.id and options and options.captions %} checked{% endif %}> Untertitel einschalten, falls vorhanden</label><label>Sprache <select name="language">{% for code, label in {'de':'Deutsch','en':'Englisch','fr':'Französisch','es':'Spanisch','it':'Italienisch'} %}<option value="{{ code }}"{% if selected == source.id and options ? options.language == code : code == 'de' %} selected{% endif %}>{{ label }}</option>{% endfor %}</select></label>{% endif %}
</div></details>{% endif %}<button>Auswählen und laden</button></form>{% else %}<p>Diese Quelle ist momentan nicht verfügbar.</p>{% endif %}</section>{% else %}<p>Keine abspielbare Quelle vorhanden.</p>{% endfor %}</div>
{% if playback %}<section class="panel workspace-player" aria-label="Videoplayer">
{% if playback.mode == 'iframe' %}<iframe src="{{ playback.url }}" title="{{ title }}" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin"></iframe>
{% elseif playback.mode in ['video','hls'] %}
{% if engine == 'videojs' %}<link rel="stylesheet" href="{{ asset('video_player_choice/player/video-8.24.1.min.css') }}">{% endif %}
<video controls playsinline preload="none" data-choice-player data-engine="{{ engine }}" data-mode="{{ playback.mode }}" data-source="{{ playback.url }}" data-library="{{ asset('video_player_choice/player/video-8.24.1.min.js') }}" data-start="{{ options.start }}" data-speed="{{ options.speed }}" data-muted="{{ options.muted ? '1' : '0' }}" data-loop="{{ options.loop ? '1' : '0' }}" data-autoplay="{{ options.autoplay ? '1' : '0' }}" aria-label="{{ title }}"></video>
<label data-quality-label hidden>Bildqualität <select data-quality><option value="-1">Automatisch</option></select></label><p data-choice-status role="status" aria-live="polite"></p>
{% else %}<p>Diese Quelle wird beim Anbieter geöffnet.</p>{% endif %}
<a href="{{ playback.url }}" target="_blank" rel="noopener noreferrer">Quelle separat öffnen</a></section>{% endif %}
{% if video %}<p><a href="{{ path('app_video_workspace_video', {slug: video.slug}) }}">Weitere Video-Funktionen</a> · <a href="{{ path('app_video_show', {slug: video.slug}) }}">Normale Videoseite</a></p>{% endif %}
<script type="module" src="{{ asset('video_player_choice/player.js') }}"></script>
{% endblock %}
