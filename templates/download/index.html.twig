{% extends 'base.html.twig' %}{% block title %}Downloads{% endblock %}{% block body %}<main class="content-shell"><h1>Downloads</h1><section class="portal-cards">{% for package in packages %}<article class="portal-card"><p class="portal-kicker">{{ package.type }}</p><h2><a href="{{ path('app_download_show',{slug:package.slug}) }}">{{ package.title }}</a></h2></article>{% else %}<p>Keine verfügbaren Downloads.</p>{% endfor %}</section></main>{% endblock %}