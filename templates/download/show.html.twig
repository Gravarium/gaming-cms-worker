{% extends 'base.html.twig' %}{% block title %}{{ package.title }}{% endblock %}{% block body %}<main class="content-shell"><h1>{{ package.title }}</h1><p>Typ: {{ package.type }}</p><div class="table-wrap"><table><thead><tr><th>Version</th><th>Kompatibilität</th><th>SHA-256</th><th>Status</th><th></th></tr></thead><tbody>{% for version in versions %}<tr><td>{{ version.version }}</td><td>{{ version.compatibility|join(', ') }}</td><td><code>{{ version.sha256 }}</code></td><td>{{ version.obsolete ? 'ersetzt' : version.scanStatus }}</td><td>{% if version.deliverable %}<a href="{{ path('app_download_file',{slug:package.slug,id:version.id}) }}">Herunterladen</a>{% endif %}</td></tr>{% else %}<tr><td colspan="5">Keine Versionen.</td></tr>{% endfor %}</tbody></table></div></main>{% endblock %}