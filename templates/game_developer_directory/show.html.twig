{% extends 'base.html.twig' %}
{% block title %}{{ developer }} – Spieleentwickler{% endblock %}
{% block body %}
<main class="content-shell">
    <header class="page-header">
        <p class="eyebrow">Spieleentwickler</p>
        <h1>{{ developer }}</h1>
        <p>{{ total }} sichtbare Spiele</p>
        <a class="button-link button-secondary" href="{{ path('app_game_developer_directory') }}">Alle Entwickler</a>
    </header>

    <section class="portal-cards" aria-label="Spiele von {{ developer }}">
        {% for entry in entries %}
            <article class="portal-card">
                <h2><a href="{{ path('app_game_catalogue_show', {slug: entry.game.slug}) }}">{{ entry.game.name }}</a></h2>
                {% if entry.summary %}<p>{{ entry.summary }}</p>{% endif %}
                {% if entry.publisher %}<p>Publisher: {{ entry.publisher.name }}</p>{% endif %}
            </article>
        {% endfor %}
    </section>

    {% if totalPages > 1 %}
        <nav aria-label="Spieleseiten">
            {% if page > 1 %}<a href="{{ path('app_game_developer_show', {developer: developer, page: page - 1}) }}">Zurück</a>{% endif %}
            <span>Seite {{ page }} von {{ totalPages }}</span>
            {% if page < totalPages %}<a href="{{ path('app_game_developer_show', {developer: developer, page: page + 1}) }}">Weiter</a>{% endif %}
        </nav>
    {% endif %}
</main>
{% endblock %}
