{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}Mein Gildenbereich | {{ site.siteName }}{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_home') }}">{{ site.siteName }}</a><nav class="top-actions"><a href="{{ path('app_account_security') }}">Kontosicherheit</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="button-secondary">Abmelden</button></form></nav></header>
<main class="dashboard"><p class="eyebrow">Geschützter Mitgliederbereich</p><h1>Meine Gilden und Charaktere</h1>
<section>
    <div class="top-actions">
        <h2>Benachrichtigungen{% if unreadNotifications %} ({{ unreadNotifications }} neu){% endif %}</h2>
        <a class="button-secondary" href="{{ path('app_member_notification_inbox') }}">Alle Benachrichtigungen</a>
        {% if unreadNotifications %}<form method="post" action="{{ path('app_member_notification_read_all') }}"><input type="hidden" name="_token" value="{{ csrf_token('member-notifications-read-all') }}"><button class="button-secondary">Alle gelesen</button></form>{% endif %}
    </div>
    {% if notifications %}
        <div class="application-list">{% for notification in notifications %}<article class="application-card"><div><p class="eyebrow">{{ notification.createdAt|date('d.m.Y H:i') }} · {{ notification.guild.name }}</p><h3>{{ notification.title }}</h3><p>{{ notification.message }}</p></div><form method="post" action="{{ path('app_member_notification_read', {id: notification.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('member-notification-' ~ notification.id) }}"><button>{{ notification.read ? 'Öffnen' : 'Lesen' }}</button></form></article>{% endfor %}</div>
    {% else %}
        <p>Du hast noch keine Benachrichtigungen.</p>
    {% endif %}
</section>
<div class="dashboard-grid">{% for member in memberships %}<a class="panel panel-link" href="{{ path('app_guild_portal_show', {id: member.guild.id}) }}"><h2>{{ member.guild.name }}</h2><p>{{ member.characterName }} · {{ member.displayRank }}</p><span class="status status-ready">{{ member.guild.game.name }}</span></a>{% else %}<article class="panel"><h2>Noch keine Gilde verknüpft</h2><p>Ein Administrator kann dein Benutzerkonto einem oder mehreren Charakteren zuordnen.</p></article>{% endfor %}</div></main>
{% endblock %}
