{% extends 'base.html.twig' %}
{% set site = site_settings() %}
{% block title %}{{ guild.name }} | Mitgliederbereich{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_guild_portal_index') }}">Mein Gildenbereich</a><nav class="top-actions"><a href="{{ path('app_guild_show', {slug: guild.slug}) }}">Öffentliche Seite</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="button-secondary">Abmelden</button></form></nav></header>
<main class="dashboard"><p class="eyebrow">{{ guild.game.name }} · {{ guild.serverName }}</p><h1>{{ guild.name }}</h1>
{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}
<section><p class="eyebrow">Nur für Mitglieder</p><h2>Mitteilungen</h2><div class="application-list">{% for item in announcements %}<article class="application-card"><p class="eyebrow">{{ item.publishedAt|date('d.m.Y H:i') }}{% if item.pinned %} · Angeheftet{% endif %}</p><h3>{{ item.title }}</h3><p>{{ item.body|nl2br }}</p></article>{% else %}<p class="muted">Keine internen Mitteilungen.</p>{% endfor %}</div></section>
<section><p class="eyebrow">Planung</p><div class="row-actions"><h2>Termine und Raids</h2><a class="button-link button-secondary" href="{{ path('app_guild_calendar', {id: guild.id}) }}">Kalender abonnieren (.ics)</a></div><div class="application-list">
{% for event in events %}<article class="application-card"><div><p class="eyebrow">{{ event.type }}{% if event.team %} · Team {{ event.team.name }}{% endif %} · {{ event.startsAt|date('d.m.Y H:i') }}</p><h3>{{ event.title }}</h3><p>{{ event.description|nl2br }}</p>{% if event.location %}<p class="muted">Treffpunkt: {{ event.location }}</p>{% endif %}</div>
{% set eventSignups = signupRepository.forEvent(event) %}<p><strong>{{ eventSignups|filter(s => s.response == 'going')|length }} Zusagen</strong>{% if event.maxParticipants %} von {{ event.maxParticipants }}{% endif %} · {{ eventSignups|filter(s => s.response == 'waitlist')|length }} Warteliste</p>
<form class="content-form" method="post" action="{{ path('app_guild_event_signup', {id: guild.id, event: event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('event-signup-' ~ event.id) }}"><label>Charakter<select name="member">{% for character in characters %}<option value="{{ character.id }}">{{ character.characterName }}</option>{% endfor %}</select></label><label>Antwort<select name="response"><option value="going">Zusage</option><option value="maybe">Vielleicht</option><option value="declined">Absage</option></select></label><label>Rolle<select name="role"><option value="tank">Tank</option><option value="heal">Heiler</option><option value="damage">Schaden</option><option value="support">Unterstützung</option><option value="other">Andere</option></select></label><label>Notiz<input name="note" maxlength="500"></label><button>Anmeldung speichern</button></form>
{% if eventSignups %}<div class="table-wrap"><table><thead><tr><th>Charakter</th><th>Antwort</th><th>Rolle</th></tr></thead><tbody>{% for signup in eventSignups %}<tr><td>{{ signup.member.characterName }}</td><td>{{ signup.response }}</td><td>{{ signup.role }}</td></tr>{% endfor %}</tbody></table></div>{% endif %}
</article>{% else %}<p class="muted">Keine kommenden Termine.</p>{% endfor %}</div></section>
<section><p class="eyebrow">Organisation</p><h2>Teams</h2><div class="roster-grid">{% for team in teams %}<article class="member-card"><h3>{{ team.name }}</h3>{% if team.description %}<p>{{ team.description }}</p>{% endif %}<p class="muted">Leitung: {{ team.leader ? team.leader.characterName : 'Nicht festgelegt' }} · {{ team.members|length }} Mitglieder</p></article>{% else %}<p class="muted">Noch keine Teams angelegt.</p>{% endfor %}</div></section>
<section class="panel"><h2>Meine Charaktere</h2><div class="roster-grid">{% for character in characters %}<article class="member-card"><h3>{{ character.characterName }}</h3><p>{{ character.displayRank }}{% if character.characterClass %} · {{ character.characterClass }}{% endif %}</p>{% if character.rank and character.rank.permissions %}<p class="muted">Rechte: {{ character.rank.permissions|join(', ') }}</p>{% endif %}</article>{% endfor %}</div></section>
<h2 class="section-heading">Interne Mitgliederliste</h2><div class="table-wrap"><table><thead><tr><th>Charakter</th><th>Rang</th><th>Klasse</th></tr></thead><tbody>{% for member in members %}<tr><td>{{ member.characterName }}</td><td>{{ member.displayRank }}</td><td>{{ member.characterClass ?: '–' }}</td></tr>{% endfor %}</tbody></table></div>
</main>{% endblock %}
