{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Video-Entdeckung: {{ video.title }}{% endblock %}
{% block workspace %}<form method="post" class="panel workspace-form"><input type="hidden" name="_token" value="{{ csrf_token('workspace-metadata-' ~ video.id) }}"><input type="hidden" name="_version" value="{{ version }}"><label>Creator<select name="creator_id"><option value="0">Kein Creator</option>{% for creator in creators %}<option value="{{ creator.id }}" {{ profile.creator and profile.creator.id == creator.id ? 'selected' : '' }}>{{ creator.displayName }}</option>{% endfor %}</select></label><label>Sichtbarkeit<select name="visibility">{% for value,label in {public:'Öffentlich',member:'Mitglieder',private:'Nur Creator-Besitzer'} %}<option value="{{ value }}" {{ profile.visibility == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label><input type="checkbox" name="discoverable" value="1" {{ profile.discoverable ? 'checked' : '' }}> In der Entdeckung anzeigen</label><label>Tags, durch Komma getrennt<input name="tags" maxlength="3000" value="{{ profile.tags|map(tag => tag.name)|join(', ') }}"></label><button>Speichern</button></form><p><a href="{{ path('app_admin_video_workspace_source_new', {video: video.id}) }}">Quelle hinzufügen</a> · <a href="{{ path('app_video_workspace_video', {slug: video.slug}) }}">Quellenauswahl öffnen</a></p>{% endblock %}
