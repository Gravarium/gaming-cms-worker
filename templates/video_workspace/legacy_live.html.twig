{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Bestehenden Livestream verwalten{% endblock %}
{% block workspace %}<form method="post" class="panel workspace-form"><input type="hidden" name="_token" value="{{ csrf_token(token) }}"><input type="hidden" name="_version" value="{{ version }}"><label>Titel<input name="title" maxlength="160" required value="{{ row.title }}"></label><label>Anbieter<select name="provider">{% for provider in ['youtube','vimeo','twitch'] %}<option value="{{ provider }}" {{ row.provider == provider ? 'selected' : '' }}>{{ provider|capitalize }}</option>{% endfor %}</select></label><label>Stream-URL<input name="source_url" type="url" maxlength="700" required value="{{ row.source_url }}"></label><label>Creator<select name="creator_id"><option value="0">Kein Creator</option>{% for creator in creators %}<option value="{{ creator.id }}" {{ row.creator_id == creator.id ? 'selected' : '' }}>{{ creator.displayName }}</option>{% endfor %}</select></label><label>Start (UTC, optional)<input type="datetime-local" name="starts_at" value="{{ row.starts_at ? row.starts_at|date('Y-m-d\\TH:i', 'UTC') : '' }}"></label><label><input type="checkbox" name="enabled" value="1" {{ row.enabled ? 'checked' : '' }}> Aktiv</label><button name="action" value="save">Speichern</button></form><form method="post" class="panel"><input type="hidden" name="_token" value="{{ csrf_token(token) }}"><input type="hidden" name="_version" value="{{ version }}"><button class="text-danger" name="action" value="delete">Stream löschen</button></form>{% endblock %}
