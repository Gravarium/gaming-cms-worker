{% extends 'video_workspace/layout.html.twig' %}{% block heading %}{{ title }}{% endblock %}
{% block workspace %}
<section class="panel"><h2>Quelle auswählen</h2><p>Die ausgewählte Quelle wird erst nach deinem Klick geladen. Dabei erhält der Anbieter Verbindungsdaten. Du kannst jederzeit eine andere Quelle wählen.</p><div class="workspace-actions">{% if video and video.playbackUrl %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('workspace-legacy-' ~ video.id) }}"><input type="hidden" name="source" value="legacy"><button class="button-secondary">Originalquelle</button></form>{% endif %}{% for source in sources %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('workspace-play-' ~ source.id) }}"><input type="hidden" name="source" value="{{ source.id }}"><button class="{{ selected and selected.id == source.id ? '' : 'button-secondary' }}">{{ source.label }}</button></form>{% else %}<p>Noch keine zusätzlichen Quellen.</p>{% endfor %}</div></section>
{% if playback %}<section class="panel workspace-player" aria-label="Videoplayer">{% if playback.mode == 'iframe' %}<iframe src="{{ playback.url }}" title="{{ title }}" allow="fullscreen; picture-in-picture; encrypted-media" allowfullscreen loading="lazy" sandbox="allow-scripts allow-same-origin allow-presentation"></iframe>{% elseif playback.mode in ['video','hls'] %}<video controls playsinline preload="none" data-workspace-player data-source="{{ playback.url }}" data-mode="{{ playback.mode }}" aria-label="{{ title }}"></video><label data-quality-label hidden>Bildqualität <select data-quality><option value="-1">Automatisch</option></select></label><p data-player-status role="status" aria-live="polite"></p><script type="module" src="{{ asset('video_workspace/player.js') }}"></script>{% else %}<p>Diese Quelle wird beim Anbieter geöffnet.</p>{% endif %}<a class="button-link button-secondary" href="{{ playback.url }}" target="_blank" rel="noopener noreferrer">Quelle separat öffnen</a></section>{% elseif selected %}<p class="alert">Diese Quelle ist momentan nicht verfügbar. Bitte wähle eine andere Quelle.</p>{% endif %}
{% if video %}<p><a href="{{ path('app_video_show', {slug: video.slug}) }}">Normale Videoseite</a> · <a href="{{ path('app_video_discovery_index') }}">Kommentare, Clips und Favoriten in der Video-Entdeckung</a></p>{% endif %}
{% endblock %}
