{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Meine Video-Sammlung verwalten{% endblock %}
{% block workspace %}<p><a href="{{ path('app_video_discovery_library') }}">Favoriten, neue Watchlists und Verlauf</a></p>{% for kind,label in {watchlist:'Watchlists',comment:'Meine Kommentare',clip:'Meine Clips'} %}<section class="panel"><h2>{{ label }}</h2>{% for row in lists[kind] %}<p><a href="{{ path('app_video_workspace_owned', {kind: kind, id: row.id}) }}">{{ row.name|default(row.title|default(row.body|default('Eintrag')))|slice(0, 100) }}</a> · Bearbeiten / löschen</p>{% else %}<p>Keine Einträge auf dieser Seite.</p>{% endfor %}</section>{% endfor %}<nav class="workspace-actions" aria-label="Sammlungsseiten">{% if page > 1 %}<a href="{{ path('app_video_workspace_account', {page: page - 1}) }}">Zurück</a>{% endif %}<span>Seite {{ page }}</span>{% if lists.watchlist|length == 20 or lists.comment|length == 20 or lists.clip|length == 20 %}<a href="{{ path('app_video_workspace_account', {page: page + 1}) }}">Weiter</a>{% endif %}</nav>{% endblock %}
