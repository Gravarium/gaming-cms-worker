{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Creator-Profil{% endblock %}
{% block workspace %}<form method="post" class="panel workspace-form"><input type="hidden" name="_token" value="{{ csrf_token(token) }}"><input type="hidden" name="_version" value="{{ version }}"><label>Name<input name="display_name" required maxlength="160" value="{{ row.display_name }}"></label><label>Beschreibung<textarea name="bio" maxlength="10000" rows="6">{{ row.bio }}</textarea></label><label>Sichtbarkeit<select name="visibility">{% for value,label in {public:'Öffentlich',member:'Mitglieder',private:'Nur Besitzer'} %}<option value="{{ value }}" {{ row.visibility == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><button name="action" value="edit">Speichern</button></form>{% if editing %}<form method="post" class="panel"><input type="hidden" name="_token" value="{{ csrf_token(token) }}"><input type="hidden" name="_version" value="{{ version }}"><p>Ein zugeordnetes Profil kann erst gelöscht werden, wenn Videos und Streams neu zugeordnet wurden.</p><button class="text-danger" name="action" value="delete">Profil löschen</button></form>{% endif %}{% endblock %}
