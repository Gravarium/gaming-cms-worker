{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Videos & Livestreams{% endblock %}
{% block workspace %}<section class="panel"><h2>Videos</h2><div class="workspace-grid">{% for video in videos %}<article class="panel"><h3><a href="{{ path('app_video_workspace_video', {slug: video.slug}) }}">{{ video.title }}</a></h3><p>Quelle auswählen und ansehen</p></article>{% else %}<p>Keine sichtbaren Videos auf dieser Seite.</p>{% endfor %}</div></section><section class="panel"><h2>Live</h2>{% for stream in streams %}<p><a href="{{ path('app_video_workspace_live', {id: stream.id}) }}">{{ stream.label }}</a>{% if stream.startsAt %} · {{ stream.startsAt|date('d.m.Y H:i', 'UTC') }} UTC{% endif %}</p>{% else %}<p>Keine sichtbaren Livestreams auf dieser Seite.</p>{% endfor %}</section><nav class="workspace-actions" aria-label="Video-Seiten">{% if page > 1 %}<a href="{{ path('app_video_workspace', {page: page - 1}) }}">Zurück</a>{% endif %}<span>Seite {{ page }}</span><a href="{{ path('app_video_workspace', {page: page + 1}) }}">Weitere Videos</a></nav>{% endblock %}
