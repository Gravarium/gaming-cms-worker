{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Videoquelle / Livestream{% endblock %}
{% block workspace %}<form method="post" class="panel workspace-form"><input type="hidden" name="_token" value="{{ csrf_token(token) }}"><input type="hidden" name="version" value="{{ source.version }}"><label>Name der Quelle<input name="label" maxlength="160" required value="{{ source.label }}"></label><label>Anbieter / Format<select name="provider">{% for key,provider in catalogue %}<option value="{{ key }}" {{ source.provider == key ? 'selected' : '' }}>{{ provider.label }}</option>{% endfor %}</select></label><label>HTTPS-Video-, Embed- oder Stream-URL<input type="url" name="url" maxlength="700" required value="{{ source.url }}"></label><label>Video-ID (0 = eigenständiger Livestream)<input type="number" name="video_id" min="0" value="{{ videoId }}" required></label><label>Creator / Sichtbarkeit des Streams<select name="creator_id"><option value="0">Kein Creator · öffentlich</option>{% for creator in creators %}<option value="{{ creator.id }}" {{ source.creator and source.creator.id == creator.id ? 'selected' : '' }}>{{ creator.displayName }} · {{ creator.visibility }}</option>{% endfor %}</select></label><label>Reihenfolge<input type="number" name="position" min="0" max="10000" value="{{ source.position }}" required></label><label>Geplanter Start (UTC, optional)<input type="datetime-local" name="starts_at" value="{{ source.startsAt ? source.startsAt|date('Y-m-d\\TH:i', 'UTC') : '' }}"></label><label><input type="checkbox" name="enabled" value="1" {{ source.enabled ? 'checked' : '' }}> Quelle aktiv</label><label><input type="checkbox" name="authorized" value="1" required {{ source.authorized ? 'checked' : '' }}> Ich darf diese Quelle einbetten bzw. direkt wiedergeben.</label><p>Direktstreams benötigen eine freigegebene .mp4-, .webm- oder .m3u8-Adresse. HLS benötigt passende CORS-Freigaben am Quellserver.</p><button name="action" value="save">Quelle speichern</button></form>{% if source.id %}<form method="post" class="panel"><input type="hidden" name="_token" value="{{ csrf_token(token) }}"><input type="hidden" name="version" value="{{ source.version }}"><button class="text-danger" name="action" value="delete">Quelle löschen</button></form>{% endif %}{% endblock %}
