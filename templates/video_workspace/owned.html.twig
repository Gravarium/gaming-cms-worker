{% extends 'video_workspace/layout.html.twig' %}{% block heading %}Eigenen Eintrag verwalten{% endblock %}
{% block workspace %}<form method="post" class="panel workspace-form"><input type="hidden" name="_token" value="{{ csrf_token('video-workspace-' ~ kind ~ '-' ~ id) }}"><input type="hidden" name="_version" value="{{ version }}">{% if kind == 'watchlist' %}<label>Name<input name="name" maxlength="120" required value="{{ row.name }}"></label><label><input type="checkbox" name="public" value="1" {{ row.public ? 'checked' : '' }}> Öffentlich</label>{% elseif kind == 'comment' %}<label>Kommentar<textarea name="body" maxlength="4000" rows="5" required>{{ row.body }}</textarea></label><label>Zeitmarke (Sekunden)<input name="timestamp_seconds" type="number" min="0" max="86400" value="{{ row.timestamp_seconds }}" required></label>{% else %}<label>Titel<input name="title" maxlength="160" required value="{{ row.title }}"></label><label>Beginn (Sekunden)<input name="start_seconds" type="number" min="0" max="86400" value="{{ row.start_seconds }}" required></label><label>Ende (Sekunden)<input name="end_seconds" type="number" min="1" max="86400" value="{{ row.end_seconds }}" required></label>{% endif %}{% if kind != 'watchlist' %}<label>Sichtbarkeit<select name="visibility">{% for value,label in {public:'Öffentlich',member:'Mitglieder'}|merge(kind == 'clip' ? {private:'Nur ich'} : {}) %}<option value="{{ value }}" {{ row.visibility == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>{% endif %}<button name="action" value="edit">Speichern</button></form>
{% if kind == 'watchlist' %}<section class="panel"><h2>Videos entfernen</h2>{% for item in items %}<form method="post" class="workspace-item"><span>{{ item.title }}</span><input type="hidden" name="_token" value="{{ csrf_token('video-workspace-' ~ kind ~ '-' ~ id) }}"><input type="hidden" name="_version" value="{{ version }}"><input type="hidden" name="item_id" value="{{ item.id }}"><button name="action" value="remove">Entfernen</button></form>{% else %}<p>Keine Videos in dieser Watchlist.</p>{% endfor %}<p>Die 100 neuesten Einträge werden angezeigt. Nach dem Entfernen bitte die Watchlist erneut öffnen.</p></section>{% endif %}
<form method="post" class="panel"><input type="hidden" name="_token" value="{{ csrf_token('video-workspace-' ~ kind ~ '-' ~ id) }}"><input type="hidden" name="_version" value="{{ version }}"><button class="text-danger" name="action" value="delete">Eintrag endgültig löschen</button></form>{% endblock %}
