{% extends 'base.html.twig' %}
{% block title %}Charakteraccount anlegen{% endblock %}
{% block body %}
<main class="admin-shell"><h1>Charakteraccount anlegen</h1>
{% if error %}<div class="notice notice-error">{{ error }}</div>{% endif %}
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('character-account-new') }}"><label>Spiel<select name="game_id" required>{% for game in games %}<option value="{{ game.id }}">{{ game.name }}</option>{% endfor %}</select></label><label>Account-Schlüssel<input name="account_key" maxlength="160" required></label><label>Anzeigename<input name="display_name" maxlength="160" required></label><button type="submit">Speichern</button></form></main>
{% endblock %}
