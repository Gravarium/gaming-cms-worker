{% extends 'base.html.twig' %}
{% block title %}{{ heading }} | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <a class="button-link button-secondary" href="{{ path('app_admin_menu_index') }}">Zurück</a>
</header>
<main class="editor-shell">
    <p class="eyebrow">Hauptmenü</p>
    <h1>{{ heading }}</h1>
    {{ form_start(form, {attr: {class: 'content-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit">Speichern</button>
    {{ form_end(form) }}
</main>
{% endblock %}
