{% extends 'base.html.twig' %}{% block title %}Content-Tags | Gaming CMS{% endblock %}{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_admin_content_index') }}">Inhalte</a><a class="button-link" href="{{ path('app_admin_content_tag_new') }}">Neuer Tag</a></header><main class="dashboard"><h1>Tags</h1>{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="notice text-danger">{{ message }}</div>{% endfor %}<div class="table-wrap"><table><thead><tr><th>Name</th><th>Slug</th><th>Verwendung</th><th>Aktionen</th></tr></thead><tbody>{% for tag in tags %}<tr><td>{{ tag.name }}</td><td>{{ tag.slug }}</td><td>{{ tag.entries|length }}</td><td class="row-actions"><a href="{{ path('app_admin_content_tag_edit',{id:tag.id}) }}">Bearbeiten</a><form method="post" action="{{ path('app_admin_content_tag_delete',{id:tag.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-content-tag-'~tag.id) }}"><button class="text-danger">Löschen</button></form></td></tr>{% endfor %}</tbody></table></div></main>{% endblock %}
