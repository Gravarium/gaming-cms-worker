{% extends 'base.html.twig' %}
{% block title %}Match-Belege | Gaming CMS{% endblock %}
{% block head_meta %}<meta name="robots" content="noindex,nofollow,noarchive">{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_admin_competition_index') }}">Gaming CMS</a><a href="{{ path('app_admin_competition_index') }}">Competitions</a></header>
<main class="dashboard">
    <p class="eyebrow">Competition · Belegprüfung</p>
    <h1>{{ competition.name }}</h1>
    <p>{{ total }} Beleg{{ total == 1 ? '' : 'e' }}{% if total > available %}; die neuesten {{ available }} sind abrufbar{% endif %}.</p>
    <form method="get" role="search" class="content-form">
        <label>Typ
            <select name="type">
                <option value="">Alle</option>
                {% for candidate in types %}<option value="{{ candidate }}" {{ type == candidate ? 'selected' }}>{{ candidate }}</option>{% endfor %}
            </select>
        </label>
        <button>Filtern</button>
    </form>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Match</th><th>Teilnehmende</th><th>Typ</th><th>Eingereicht</th><th>Zeit</th><th>Beleg</th></tr></thead>
            <tbody>
            {% for item in evidence %}
                <tr>
                    <td>Runde {{ item.roundNumber }}, #{{ item.sequence }} ({{ item.bracket }})</td>
                    <td>{{ item.participantAName ?? 'Offen' }} – {{ item.participantBName ?? 'Offen' }}</td>
                    <td>{{ item.type }}</td>
                    <td>{{ item.submitterName }}</td>
                    <td>{{ item.createdAt|date('d.m.Y H:i') }}</td>
                    <td>{% if item.locator %}<a href="{{ item.locator }}" target="_blank" rel="noopener noreferrer">Beleg öffnen</a>{% else %}<span>Ungültiger Link entfernt</span>{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="6">Keine passenden Belege vorhanden.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if pages > 1 %}<nav aria-label="Seitennavigation">
        {% if page > 1 %}<a rel="prev" href="{{ path('app_admin_competition_evidence', {id: competition.id, type: type, page: page - 1}) }}">Zurück</a>{% endif %}
        <span>Seite {{ page }} von {{ pages }}</span>
        {% if page < pages %}<a rel="next" href="{{ path('app_admin_competition_evidence', {id: competition.id, type: type, page: page + 1}) }}">Weiter</a>{% endif %}
    </nav>{% endif %}
</main>
{% endblock %}
