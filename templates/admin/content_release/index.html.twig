{% extends 'base.html.twig' %}{% block title %}Content-Releases | Gaming CMS{% endblock %}{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_admin_content_index') }}">Inhalte</a><a class="button-link" href="{{ path('app_admin_content_release_new') }}">Neuer Release</a></header><main class="dashboard"><p class="eyebrow">Editorial Orchestration</p><h1>Content-Releases</h1>{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="notice text-danger">{{ message }}</div>{% endfor %}<div class="table-wrap"><table><thead><tr><th>Name</th><th>Status</th><th>Inhalte</th><th>Zeitpunkt</th><th>Aktionen</th></tr></thead><tbody>{% for release in releases %}<tr><td>{{ release.name }}</td><td>{{ release.status }}</td><td>{{ release.entries|length }}</td><td>{{ release.scheduledAt ? release.scheduledAt|date('d.m.Y H:i') : (release.publishedAt ? release.publishedAt|date('d.m.Y H:i') : '—') }}</td><td class="row-actions">{% if release.status!='published' %}<a href="{{ path('app_admin_content_release_edit',{id:release.id}) }}">Bearbeiten</a><form method="post" action="{{ path('app_admin_content_release_publish',{id:release.id}) }}" onsubmit="return confirm('Alle enthaltenen Inhalte jetzt gemeinsam veröffentlichen?')"><input type="hidden" name="_token" value="{{ csrf_token('publish-content-release-'~release.id) }}"><button>Jetzt veröffentlichen</button></form><form method="post" action="{{ path('app_admin_content_release_delete',{id:release.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('delete-content-release-'~release.id) }}"><button class="text-danger">Löschen</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5">Noch keine Releases.</td></tr>{% endfor %}</tbody></table></div></main>{% endblock %}
