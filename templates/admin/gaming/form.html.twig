{% extends 'base.html.twig' %}
{% block title %}{{ heading }} | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <a class="button-link button-secondary" href="{{ path('app_admin_gaming_index') }}">Zurück</a>
</header>
<main class="editor-shell">
    <p class="eyebrow">Gaming-Modul</p>
    <h1>{{ heading }}</h1>
    {% if storageMode is defined %}
        <div class="storage-hint">
            <strong>Logo-Speicher: {{ storageMode == 'external' ? 'Extern' : 'Intern' }}</strong>
            <span>
                {% if storageMode == 'external' %}
                    {{ externalStorageReady ? 'Hochgeladene Logos werden automatisch extern gespeichert.' : 'Verwende bis zur S3-Einrichtung eine externe Logo-URL.' }}
                {% else %}
                    Hochgeladene Logos werden auf diesem CMS-Server gespeichert.
                {% endif %}
            </span>
        </div>
    {% endif %}
    {% if guild is defined and guild.logo %}
        <div class="branding-preview"><img src="{{ guild.logo.location }}" alt="{{ guild.name }}"></div>
    {% endif %}
    {{ form_start(form, {attr: {class: 'content-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit">Speichern</button>
    {{ form_end(form) }}
</main>
{% endblock %}
