{% extends 'base.html.twig' %}
{% block title %}Layout-Werkstatt | {{ site.siteName }}{% endblock %}
{% block body %}
<div class="layout-editor" data-controller="layout-editor" data-layout-editor-state-value="{{ editor|json_encode|e('html_attr') }}" data-layout-editor-save-url-value="{{ path('app_admin_layout_write',{context:context,operation:'save'}) }}" data-layout-editor-preview-url-value="{{ path('app_admin_layout_write',{context:context,operation:'preview'}) }}" data-layout-editor-token-value="{{ csrf_token('layout-'~context) }}">
<header class="editor-header"><div><p class="portal-kicker">GRAVARIUM / DESIGN</p><h1>Layout-Werkstatt</h1><p>Deine Seite. Dein Aufbau. Jedes Widget an seinem Platz.</p></div><a href="{{ path('app_admin_settings') }}">← Website-Einstellungen</a></header>
<nav class="editor-contexts" aria-label="Seite auswählen"><a href="{{ path('app_admin_layout',{context:'home'}) }}" {{ context=='home'?'aria-current="page"':'' }}>Startseite</a>{% for page in pages %}<a href="{{ path('app_admin_layout',{context:'page-'~page.id}) }}" {{ context=='page-'~page.id?'aria-current="page"':'' }}>{{ page.title }}</a>{% endfor %}</nav>
<div class="editor-toolbar"><label>Theme <select data-layout-editor-target="theme" data-action="change->layout-editor#themeChanged"></select></label><button type="button" data-action="layout-editor#preview">Vorschau</button><button type="button" data-action="layout-editor#save">Speichern und veröffentlichen</button><span data-layout-editor-target="status" role="status" aria-live="polite">Noch keine Änderungen.</span></div>
<p class="editor-note">Die Vorschau speichert nichts. „Speichern und veröffentlichen“ ändert diese Seite sofort. Der Seiteninhalt bleibt erhalten. Nicht verfügbare Widgets bleiben gespeichert und werden öffentlich ausgeblendet.</p>
<noscript><p>Der Layout-Editor benötigt JavaScript. Bestehende Seiten bleiben ohne JavaScript lesbar.</p></noscript>
<div class="editor-workspace"><aside class="editor-palette"><h2>Widgets hinzufügen</h2><div data-layout-editor-target="palette"></div><details><summary>Theme-Einstellungen</summary><div data-layout-editor-target="options"></div></details><p>Verschieben: ziehen oder Region auswählen. Reihenfolge: ↑ und ↓.</p></aside><div class="editor-canvas" data-layout-editor-target="canvas"></div></div>
<section class="editor-preview" aria-label="Seitenvorschau"><div class="editor-preview-tools"><strong>Vorschau</strong><button type="button" data-action="layout-editor#viewport" data-width="100%">Desktop</button><button type="button" data-action="layout-editor#viewport" data-width="768px">Tablet</button><button type="button" data-action="layout-editor#viewport" data-width="390px">Mobil</button></div><iframe title="Nicht gespeicherte Seitenvorschau" sandbox="" data-layout-editor-target="preview"></iframe></section>
</div>
{% endblock %}
