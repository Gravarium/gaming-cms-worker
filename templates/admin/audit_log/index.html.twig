{% extends 'base.html.twig' %}
{% block title %}Änderungsprotokoll | Gaming CMS{% endblock %}
{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><a class="button-link button-secondary" href="{{ path('app_admin_dashboard') }}">Zurück</a></header><main class="dashboard"><p class="eyebrow">Sicherheit</p><h1>Änderungsprotokoll</h1><p class="muted">Passwörter, Schlüssel und andere Geheimnisse werden nicht protokolliert.</p><div class="table-wrap"><table><thead><tr><th>Zeit</th><th>Benutzer</th><th>Aktion</th><th>Beschreibung</th><th>IP</th></tr></thead><tbody>{% for log in logs %}<tr><td>{{ log.createdAt|date('d.m.Y H:i:s') }}</td><td>{{ log.actor ? log.actor.email : 'System' }}</td><td>{{ log.action }}</td><td>{{ log.summary }}</td><td>{{ log.ipAddress ?: '–' }}</td></tr>{% else %}<tr><td colspan="5">Noch keine protokollierten Änderungen.</td></tr>{% endfor %}</tbody></table></div></main>{% endblock %}
