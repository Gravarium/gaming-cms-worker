{% extends 'base.html.twig' %}
{% block title %}Mehrere Dateien hochladen | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <a class="button-link button-secondary" href="{{ path('app_admin_storage_index') }}">Zur Medienbibliothek</a>
    <a class="button-link button-secondary" href="{{ path('app_admin_media_upload') }}">Einzelne Datei hochladen</a>
</header>
<main class="editor-shell">
    <p class="eyebrow">Medienbibliothek</p>
    <h1>Mehrere Dateien hochladen</h1>
    <p class="muted">Wähle ein Zielmodul, optional einen Ordner und bis zu 10 Bilder oder Dokumente aus. Jede Datei darf höchstens 25 MB groß sein; strengere Modulgrenzen und die Schadsoftwareprüfung bleiben aktiv.</p>
    {% if not externalStorageReady %}
        <div class="alert">Module mit externem Speicher können erst Dateien hochladen, wenn die S3-Zugangsdaten auf dem Server eingerichtet sind.</div>
    {% endif %}
    {{ form_start(form, {attr: {class: 'content-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit">Dateien sicher hochladen</button>
    {{ form_end(form) }}
</main>
{% endblock %}
