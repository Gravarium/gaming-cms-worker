{% extends 'base.html.twig' %}
{% block title %}Verwendungen: {{ asset.title }} | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><a class="button-link button-secondary" href="{{ path('app_admin_media_edit', {id: asset.id}) }}">Zurück zum Medium</a></header>
<main class="dashboard">
    {% set statusLabels = {'draft':'Entwurf','review':'Zur Freigabe','scheduled':'Geplant','published':'Veröffentlicht','archived':'Archiviert','trashed':'Papierkorb'} %}
    <p class="eyebrow">Medienbibliothek · Verwendungsdetails</p>
    <h1>{{ asset.title }}</h1>
    <p class="muted">Diese schreibgeschützte Übersicht zeigt Inhalte und Seitenlayouts, die auf dieses Medium verweisen.</p>

    <section aria-labelledby="content-usages-heading">
        <h2 id="content-usages-heading">Seiten und News</h2>
        {% if canManageContent %}
            <ul>
                {% for entry in contentReferences.items %}
                    <li data-usage-kind="content" data-content-entry-id="{{ entry.id }}">
                        <strong>{{ entry.title }}</strong>
                        <span>{{ entry.type == 'news' ? 'News' : 'Seite' }} · {{ statusLabels[entry.status] ?? entry.status }}</span>
                        <small>Verwendung in: {{ entry.areas|join(', ') }}</small>
                        <a href="{{ path('app_admin_content_edit', {id: entry.id}) }}">Inhalt bearbeiten</a>
                    </li>
                {% else %}
                    <li>Keine bekannten Seiten oder News verwenden dieses Medium.</li>
                {% endfor %}
            </ul>
            {% if contentReferences.truncated %}<p class="muted">Es werden höchstens 50 Inhaltsverwendungen angezeigt.</p>{% endif %}
        {% else %}
            <p class="muted">Inhaltsdetails sind nur mit aktivem Content-Modul und Content-Verwaltungsrecht sichtbar.</p>
        {% endif %}
    </section>

    <section aria-labelledby="layout-usages-heading">
        <h2 id="layout-usages-heading">Seitenlayouts</h2>
        <ul>
            {% for layout in layoutReferences.items %}
                <li data-usage-kind="layout">
                    <strong>{{ layout.label }}</strong>
                    {% if canManageLayouts %}<a href="{{ path('app_admin_layout', {context: layout.context}) }}">Layout bearbeiten</a>{% endif %}
                </li>
            {% else %}
                <li>Kein bekanntes Seitenlayout verwendet dieses Medium.</li>
            {% endfor %}
        </ul>
        {% if layoutReferences.truncated %}<p class="muted">Es werden höchstens 50 Layoutverwendungen angezeigt.</p>{% endif %}
    </section>
</main>
{% endblock %}
