{% extends 'base.html.twig' %}
{% block title %}Videos verwalten | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <nav class="top-actions">
        <a class="button-link" href="{{ path('app_admin_video_new', videoBrowser.query) }}">Neues Video</a>
        <a class="button-link button-secondary" href="{{ path('app_admin_video_category_new') }}">Neue Kategorie</a>
        <a class="button-link button-secondary" href="{{ path('app_admin_video_playlist_new') }}">Neue Playlist</a>
        <a class="button-link button-secondary" href="{{ path('app_admin_dashboard') }}">Übersicht</a>
    </nav>
</header>
<main class="dashboard">
    <p class="eyebrow">Video-Modul</p>
    <h1>Videos, Kategorien und Playlists</h1>
    <div class="storage-hint"><strong>Dateispeicher: {{ storageMode == 'external' ? 'Extern' : 'Intern' }}</strong><span>Hochgeladene Videos folgen automatisch dieser Moduleinstellung.</span></div>
    {% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}
    {% for message in app.flashes('error') %}<div class="alert">{{ message }}</div>{% endfor %}

    <section class="panel" aria-labelledby="video-filter-heading">
        <h2 id="video-filter-heading">Videobibliothek durchsuchen</h2>
        <form method="get" action="{{ path('app_admin_video_index') }}" class="filter-form">
            <label for="video-search">Titel</label>
            <input id="video-search" type="search" name="search" maxlength="100" value="{{ videoBrowser.search }}">
            <label for="video-status">Veröffentlichung</label>
            <select id="video-status" name="status">
                <option value="all" {{ videoBrowser.status == 'all' ? 'selected' : '' }}>Alle Zustände</option>
                <option value="published" {{ videoBrowser.status == 'published' ? 'selected' : '' }}>Veröffentlicht</option>
                <option value="scheduled" {{ videoBrowser.status == 'scheduled' ? 'selected' : '' }}>Geplant</option>
                <option value="draft" {{ videoBrowser.status == 'draft' ? 'selected' : '' }}>Entwurf</option>
                <option value="disabled" {{ videoBrowser.status == 'disabled' ? 'selected' : '' }}>Deaktiviert</option>
            </select>
            <label for="video-category">Kategorie</label>
            <select id="video-category" name="category">
                <option value="">Alle Kategorien</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ videoBrowser.category == category.id ? 'selected' : '' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
            <button type="submit">Filter anwenden</button>
            {% if videoBrowser.query %}<a class="button-link button-secondary" href="{{ path('app_admin_video_index') }}">Filter zurücksetzen</a>{% endif %}
        </form>
    </section>

    <section id="video-inventory" aria-labelledby="video-inventory-heading">
    <h2 id="video-inventory-heading" class="section-heading">Videos</h2>
    <p class="muted" aria-live="polite">{{ videoBrowser.total }} Videos · Seite {{ videoBrowser.page }} von {{ videoBrowser.pageCount }}</p>
    <div class="table-wrap">
        <table>
            <thead><tr><th>Titel</th><th>Quelle</th><th>Kategorie</th><th>Veröffentlichung</th><th>Aktionen</th></tr></thead>
            <tbody>
            {% for video in videos %}
                <tr>
                    <td><span class="video-title">{{ video.title }}</span>{% if video.featured %} <span class="status">Hervorgehoben</span>{% endif %}</td>
                    <td>{{ video.sourceType|capitalize }}</td>
                    <td>{{ video.category ? video.category.name : '–' }}</td>
                    <td>
                        {% if not video.enabled %}<span class="status status-disabled">Deaktiviert</span>
                        {% elseif video.published %}<span class="status status-ready">Veröffentlicht</span>
                        {% elseif video.publishedAt %}<span class="status">Geplant: {{ video.publishedAt|date('d.m.Y H:i') }} Uhr</span>
                        {% else %}<span class="status">Entwurf</span>{% endif %}
                    </td>
                    <td class="row-actions">
                        {% if video.published %}<a href="{{ path('app_video_show', {slug: video.slug}) }}">Ansehen</a>{% endif %}
                        <a href="{{ path('app_admin_video_edit', {id: video.id}|merge(videoBrowser.query)) }}">Bearbeiten</a>
                        <form class="video-delete-form" method="post" action="{{ path('app_admin_video_delete', {id: video.id}|merge(videoBrowser.query)) }}" onsubmit="return confirm('Video wirklich löschen?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete-video-' ~ video.id) }}">
                            <button class="text-danger" type="submit">Löschen</button>
                        </form>
                    </td>
                </tr>
            {% else %}<tr><td colspan="5">{% if videoBrowser.total > 0 %}Keine Videos auf dieser Seite.{% elseif videoBrowser.search != '' or videoBrowser.status != 'all' or videoBrowser.category %}Keine Videos entsprechen diesen Filtern.{% else %}Noch keine Videos vorhanden.{% endif %}</td></tr>{% endfor %}
            </tbody>
        </table>
    </div>
    {% if videoBrowser.pageCount > 1 %}
        <nav class="pagination" aria-label="Videoseiten">
            {% if videoBrowser.page > 1 %}
                <a href="{{ path('app_admin_video_index', videoBrowser.query|merge({page: videoBrowser.page - 1})) }}" aria-label="Vorherige Seite">Zurück</a>
            {% endif %}
            <span>Seite {{ videoBrowser.page }} von {{ videoBrowser.pageCount }}</span>
            {% if videoBrowser.page < videoBrowser.pageCount %}
                <a href="{{ path('app_admin_video_index', videoBrowser.query|merge({page: videoBrowser.page + 1})) }}" aria-label="Nächste Seite">Weiter</a>
            {% endif %}
        </nav>
    {% endif %}
    </section>

    <div class="video-admin-columns">
        <section>
            <h2 class="section-heading">Kategorien</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Name</th><th>Status</th><th>Aktionen</th></tr></thead>
                    <tbody>
                    {% for category in categories %}
                        <tr>
                            <td>{{ category.name }}</td>
                            <td>{{ category.enabled ? 'Sichtbar' : 'Ausgeblendet' }}</td>
                            <td class="row-actions">
                                <a href="{{ path('app_admin_video_category_edit', {id: category.id}) }}">Bearbeiten</a>
                                <form method="post" action="{{ path('app_admin_video_category_delete', {id: category.id}) }}" onsubmit="return confirm('Kategorie wirklich löschen?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-video-category-' ~ category.id) }}">
                                    <button class="text-danger" type="submit">Löschen</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}<tr><td colspan="3">Noch keine Kategorien vorhanden.</td></tr>{% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
        <section>
            <h2 class="section-heading">Playlists</h2>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>Titel</th><th>Videos</th><th>Aktionen</th></tr></thead>
                    <tbody>
                    {% for playlist in playlists %}
                        <tr>
                            <td>{{ playlist.title }}</td>
                            <td>{{ playlist.videos|length }}</td>
                            <td class="row-actions">
                                <a href="{{ path('app_admin_video_playlist_edit', {id: playlist.id}) }}">Bearbeiten</a>
                                <form method="post" action="{{ path('app_admin_video_playlist_delete', {id: playlist.id}) }}" onsubmit="return confirm('Playlist wirklich löschen?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-video-playlist-' ~ playlist.id) }}">
                                    <button class="text-danger" type="submit">Löschen</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}<tr><td colspan="3">Noch keine Playlists vorhanden.</td></tr>{% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</main>
{% endblock %}
