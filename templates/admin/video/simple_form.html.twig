{% extends 'base.html.twig' %}
{% block title %}{{ heading }} | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <a class="button-link button-secondary" href="{{ path('app_admin_video_index') }}">Zurück</a>
</header>
<main class="editor-shell">
    <p class="eyebrow">Video-Modul</p>
    <h1>{{ heading }}</h1>
    {% if heading starts with 'Playlist' and cms_module_enabled('video') %}
        <p><a class="button-link button-secondary" href="{{ path('app_video_playlist_index') }}">Öffentliche Playlist-Seiten ansehen</a></p>
    {% endif %}
    {{ form_start(form, {attr: {class: 'content-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit">Speichern</button>
    {{ form_end(form) }}
</main>
{% endblock %}
