{% extends 'base.html.twig' %}
{% block title %}Administration | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_home') }}">Gaming CMS</a><nav class="top-actions">{% if cms_module_enabled('gaming') %}<a href="{{ path('app_guild_portal_index') }}">Mein Gildenbereich</a>{% endif %}<a href="{{ path('app_account_security') }}">Kontosicherheit</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="button-secondary">Abmelden</button></form></nav></header>
<main class="dashboard"><p class="eyebrow">Administration</p><h1>Willkommen, {{ app.user.displayName }}</h1><p class="muted">Du siehst nur die Bereiche, für die dein Konto freigeschaltet ist und deren Module aktiv sind.</p>
<section class="dashboard-grid" aria-label="CMS-Bereiche">
{% if is_granted('CMS_ACCESS') and cms_module_enabled('notifications') %}<a class="panel panel-link" href="{{ path('app_admin_notification_index') }}"><h2>Benachrichtigungen</h2><p>Neue Bewerbungen und wichtige Systemmeldungen ansehen.</p><span class="status {{ unreadNotifications ? 'status-ready' : 'status-disabled' }}">{{ unreadNotifications ? unreadNotifications ~ ' neu' : 'Alles gelesen' }}</span></a>{% endif %}
{% if is_granted('CMS_CONTENT_MANAGE') and cms_module_enabled('content') %}<a class="panel panel-link" href="{{ path('app_admin_content_index') }}"><h2>Inhalte</h2><p>Seiten und News verwalten.</p><span class="status status-ready">Zugriff erlaubt</span></a><a class="panel panel-link" href="{{ path('app_admin_category_index') }}"><h2>Kategorien</h2><p>Inhaltskategorien strukturieren und pflegen.</p><span class="status status-ready">Content-Modul aktiv</span></a><a class="panel panel-link" href="{{ path('app_admin_menu_index') }}"><h2>Navigation</h2><p>Öffentliche Menüpunkte und Seitenziele verwalten.</p><span class="status status-ready">Content-Modul aktiv</span></a>{% endif %}
{% if is_granted('CMS_GAMING_MANAGE') and cms_module_enabled('gaming') %}<a class="panel panel-link" href="{{ path('app_admin_gaming_index') }}"><h2>Gaming und Gilden</h2><p>Spiele, Gilden, Mitglieder, Ränge und Bewerbungen verwalten.</p><span class="status status-ready">Modul aktiv</span></a>{% endif %}
{% if is_granted('CMS_VIDEO_MANAGE') and cms_module_enabled('video') %}<a class="panel panel-link" href="{{ path('app_admin_video_index') }}"><h2>Videos</h2><p>Uploads, externe Videos, Kategorien und Playlists verwalten.</p><span class="status status-ready">Zugriff erlaubt</span></a>{% endif %}
{% if is_granted('CMS_STORAGE_MANAGE') and cms_module_enabled('media') %}<a class="panel panel-link" href="{{ path('app_admin_storage_index') }}"><h2>Speicher und Medien</h2><p>Internen oder externen Speicher für jedes Modul getrennt festlegen.</p><span class="status status-ready">Zugriff erlaubt</span></a>{% endif %}
{% if is_granted('CMS_CONNECTORS_MANAGE') and cms_module_enabled('integrations') %}<a class="panel panel-link" href="{{ path('app_admin_connector_index') }}"><h2>Externe Ziele</h2><p>Beliebig viele Anbieter pro Fähigkeit planen, ordnen und unabhängig schalten.</p><span class="status status-ready">Mehrziel-Verwaltung</span></a><a class="panel panel-link" href="{{ path('app_admin_backup_index') }}"><h2>Backup und Wiederherstellung</h2><p>Lokalen Bestand, vollständige Prüfungen und Wiederherstellungsbereitschaft ansehen.</p><span class="status status-ready">Geschütztes Recovery-Center</span></a>{% endif %}
{% if is_granted('CMS_USERS_MANAGE') and cms_module_enabled('users') %}<a class="panel panel-link" href="{{ path('app_admin_user_index') }}"><h2>Benutzer und Rechte</h2><p>Konten, Einzelberechtigungen, Administratorrechte und Sperrungen verwalten.</p><span class="status status-ready">Zugriff erlaubt</span></a>{% endif %}
{% if is_granted('CMS_SETTINGS_MANAGE') %}<a class="panel panel-link" href="{{ path('app_admin_module_index') }}"><h2>Modulverwaltung</h2><p>Module zentral schalten, Versionen und Abhängigkeiten kontrollieren.</p><span class="status status-ready">Lebenszyklus aktiv</span></a><a class="panel panel-link" href="{{ path('app_admin_settings') }}"><h2>Website und System</h2><p>Name, Module, Startseite, Farben, Logo und Favicon verwalten.</p><span class="status status-ready">Zugriff erlaubt</span></a>{% if cms_module_enabled('operations') %}<a class="panel panel-link" href="{{ path('app_admin_queue_index') }}"><h2>Nachrichten-Warteschlange</h2><p>Endgültig fehlgeschlagene Hintergrundaufgaben sicher prüfen und erneut einplanen.</p><span class="status status-ready">Wiederherstellung aktiv</span></a>{% endif %}{% endif %}
{% if is_granted('CMS_AUDIT_VIEW') %}<a class="panel panel-link" href="{{ path('app_admin_audit_log') }}"><h2>Änderungsprotokoll</h2><p>Sicherheitsrelevante Änderungen und Gildenaktionen nachvollziehen.</p><span class="status status-ready">Protokoll aktiv</span></a>{% endif %}
</section></main>
{% endblock %}
