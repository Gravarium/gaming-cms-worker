{% extends 'base.html.twig' %}
{% block title %}{{ heading }} | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <nav class="top-actions">
        <a class="button-link button-secondary" href="{{ path('app_admin_access_role_index') }}">Zurück</a>
        {% if role.id is not null %}<a class="button-link" href="{{ path('app_admin_access_role_duplicate', {id: role.id}) }}">Rolle kopieren</a>{% endif %}
    </nav>
</header>
<main class="editor-shell"><p class="eyebrow">Zugriffsverwaltung</p><h1>{{ heading }}</h1>{% if role.systemRole %}<div class="notice">Dies ist eine mitgelieferte Systemrolle. Ihr Schlüssel und ihre Löschung sind geschützt; Rechte und Status können angepasst werden.</div>{% endif %}
{% if role.id is null and heading == 'Rolle kopieren' %}<div class="notice">Die Kopie startet inaktiv und ohne Benutzerzuweisungen. Prüfe die Rechte und den neuen technischen Schlüssel, bevor du sie speicherst.</div>{% endif %}
{{ form_start(form, {attr: {class: 'content-form'}}) }}{{ form_widget(form) }}<button>Rolle speichern</button>{{ form_end(form) }}</main>
{% endblock %}
