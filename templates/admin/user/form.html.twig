{% extends 'base.html.twig' %}
{% block title %}{{ heading }} | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><nav class="top-actions">{% if edited_user is defined %}<a class="button-link button-secondary" href="{{ path('app_admin_user_sessions', {id: edited_user.id}) }}">Sitzungen</a>{% endif %}<a class="button-link button-secondary" href="{{ path('app_admin_user_index') }}">Zurück</a></nav></header>
<main class="editor-shell"><p class="eyebrow">Benutzerverwaltung</p><h1>{{ heading }}</h1>
{{ form_start(form, {attr: {class: 'content-form'}}) }}
{{ form_row(form.displayName) }}{{ form_row(form.email) }}{{ form_row(form.admin) }}
<section class="panel"><h2>Zentrale Rollenprofile</h2><p class="muted">Rollen bündeln Rechte und können später zentral für alle zugewiesenen Benutzer geändert werden.</p>{{ form_row(form.accessRoles) }}</section>
<section class="panel"><h2>Zusätzliche Einzelrechte</h2><p class="muted">Nur für Ausnahmen verwenden. Volladministratoren besitzen automatisch alle Rechte.</p>{{ form_row(form.permissions) }}</section>
<section class="panel"><h2>Kontostatus und Sperre</h2>{{ form_row(form.active) }}{{ form_row(form.lockedUntil) }}{{ form_row(form.lockReason) }}<p class="muted">Eine neue Sperre oder sicherheitsrelevante Rechteänderung meldet andere Sitzungen automatisch ab.</p></section>
{{ form_row(form.plainPassword) }}<button type="submit">Speichern</button>{{ form_end(form) }}
</main>
{% endblock %}
