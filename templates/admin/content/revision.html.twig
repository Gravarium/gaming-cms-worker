{% extends 'base.html.twig' %}{% block title %}Revision #{{ revision.revisionNumber }} | Gaming CMS{% endblock %}{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><a href="{{ path('app_admin_content_history',{id:entry.id}) }}">Zurück zur Historie</a></header><main class="article-shell"><p class="eyebrow">Unveränderlicher Snapshot #{{ revision.revisionNumber }}</p><h1>{{ revision.title }}</h1>{% if revision.subtitle %}<h2>{{ revision.subtitle }}</h2>{% endif %}<p class="muted">{{ revision.createdAt|date('d.m.Y H:i:s') }} · {{ revision.createdBy.email }} · Status {{ revision.status }}</p>{% if revision.excerpt %}<p class="article-lead">{{ revision.excerpt }}</p>{% endif %}<div class="article-body">{{ revision.body|content_blocks_render }}</div>{% if revision.tagSlugs|length %}<p>Tags: {{ revision.tagSlugs|join(', ') }}</p>{% endif %}</main>{% endblock %}
