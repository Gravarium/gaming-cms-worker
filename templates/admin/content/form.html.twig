{% extends 'base.html.twig' %}

{% block title %}{{ heading }} | Gaming CMS{% endblock %}

{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <nav class="top-actions">
        {% if entry is defined %}<a class="button-link button-secondary" href="{{ path('app_admin_content_history', {id: entry.id}) }}">Versionen</a>{% endif %}
        <a class="button-link button-secondary" href="{{ path('app_admin_content_index') }}">Zurück</a>
    </nav>
</header>

<main class="editor-shell">
    <p class="eyebrow">Inhalte</p>
    <h1>{{ heading }}</h1>

    {{ form_start(form, {attr: {class: 'content-form'}}) }}
        {{ form_row(form.type) }}
        {{ form_row(form.title) }}
        {{ form_row(form.category) }}
        {{ form_row(form.excerpt) }}
        {{ form_row(form.body) }}
        {{ form_row(form.status) }}
        {{ form_row(form.scheduledAt) }}
        <button type="submit">Speichern</button>
    {{ form_end(form) }}
</main>
{% endblock %}
