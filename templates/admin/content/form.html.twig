{% extends 'base.html.twig' %}{% block title %}{{ heading }} | Gaming CMS{% endblock %}{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><nav class="top-actions">{% if entry is defined %}<a class="button-link" href="{{ path('app_admin_content_preview',{id:entry.id}) }}" target="_blank" rel="noopener">Vorschau</a><a class="button-link button-secondary" href="{{ path('app_admin_content_history',{id:entry.id}) }}">Versionen</a>{% endif %}<a class="button-link button-secondary" href="{{ path('app_admin_content_index') }}">Zurück</a></nav></header><main class="editor-shell"><p class="eyebrow">Inhalte · Editorial Workspace</p><h1>{{ heading }}</h1>{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}{{ form_start(form,{attr:{class:'content-form'}}) }}<fieldset><legend>Grunddaten</legend>{{ form_row(form.type) }}{{ form_row(form.title) }}{{ form_row(form.subtitle) }}{{ form_row(form.slug) }}{{ form_row(form.category) }}{{ form_row(form.tags) }}</fieldset><fieldset><legend>Inhalt</legend>{{ form_row(form.excerpt) }}{{ form_row(form.body) }}</fieldset><fieldset><legend>Publishing</legend>{{ form_row(form.status) }}{{ form_row(form.scheduledAt) }}{{ form_row(form.scheduledUnpublishAt) }}{{ form_row(form.featured) }}{{ form_row(form.pinned) }}{{ form_row(form.unlisted) }}</fieldset><fieldset><legend>SEO & Sharing</legend>{{ form_row(form.seoTitle) }}{{ form_row(form.seoDescription) }}{{ form_row(form.canonicalUrl) }}{{ form_row(form.noIndex) }}</fieldset><button type="submit">Speichern</button>{{ form_end(form) }}{% if entry is defined %}<hr><div class="top-actions"><form method="post" action="{{ path('app_admin_content_duplicate',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('duplicate-content-'~entry.id) }}"><button>Als Entwurf duplizieren</button></form>{% if entry.status!='trashed' %}<form method="post" action="{{ path('app_admin_content_trash',{id:entry.id}) }}" onsubmit="return confirm('In den Papierkorb verschieben?')"><input type="hidden" name="_token" value="{{ csrf_token('trash-content-'~entry.id) }}"><button class="text-danger">Papierkorb</button></form>{% else %}<form method="post" action="{{ path('app_admin_content_restore_trash',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('restore-trash-content-'~entry.id) }}"><button>Wiederherstellen</button></form>{% endif %}</div>{% endif %}</main>{% endblock %}
