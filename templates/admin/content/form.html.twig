{% extends 'base.html.twig' %}
{% block title %}{{ heading }} | Gaming CMS{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('styles/content-editor.css') }}">{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><nav class="top-actions">{% if entry is defined %}<a class="button-link" href="{{ path('app_admin_content_preview',{id:entry.id}) }}" target="_blank" rel="noopener">Gespeicherte Vorschau</a><a class="button-link button-secondary" href="{{ path('app_admin_content_history',{id:entry.id}) }}">Versionen</a>{% endif %}<a class="button-link button-secondary" href="{{ path('app_admin_content_index') }}">Zurück</a></nav></header>
<main class="editor-shell"><p class="eyebrow">Inhalte · Editorial Workspace</p><h1>{{ heading }}</h1>{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}
{{ form_start(form,{attr:{class:'content-form'}}) }}
<fieldset><legend>Grunddaten</legend>{{ form_row(form.type) }}{{ form_row(form.title) }}{{ form_row(form.subtitle) }}{{ form_row(form.slug) }}{{ form_row(form.category) }}{{ form_row(form.tags) }}</fieldset>
<fieldset><legend>Inhalt</legend>{{ form_row(form.excerpt) }}
<div class="content-editor" data-controller="content-editor" data-content-editor-autosave-enabled-value="{{ entry is defined and entry.status in ['draft','review'] ? 'true' : 'false' }}" {% if entry is defined %}data-content-editor-preview-url-value="{{ path('app_admin_content_editor_preview',{id:entry.id}) }}" data-content-editor-autosave-url-value="{{ path('app_admin_content_editor_autosave',{id:entry.id}) }}" data-content-editor-token-value="{{ csrf_token('content-editor-'~entry.id) }}" data-content-editor-updated-at-value="{{ entry.updatedAt|date('c') }}"{% endif %}>
<div class="content-editor__toolbar" aria-label="Block hinzufügen"><button type="button" data-action="content-editor#addText">+ Text</button><button type="button" data-action="content-editor#addHeading">+ Überschrift</button><button type="button" data-action="content-editor#addList">+ Liste</button><button type="button" data-action="content-editor#addQuote">+ Zitat</button><button type="button" data-action="content-editor#addLink">+ Link</button><button type="button" data-action="content-editor#addMedia">+ Medium</button></div>
<div class="content-editor__blocks" data-content-editor-target="blocks"></div>
<div class="content-editor__actions"><button type="button" data-action="content-editor#preview">Server-Vorschau aktualisieren</button>{% if entry is defined and entry.status not in ['draft','review'] %}<span class="muted">Autosave ist für veröffentlichte/geplante Inhalte deaktiviert; dadurch ändert Vorschau niemals den öffentlichen Stand.</span>{% endif %}</div>
<p class="content-editor__status muted" data-content-editor-target="status" aria-live="polite"></p><div class="content-editor__preview article-body" data-content-editor-target="preview"></div><div class="content-editor__source">{{ form_row(form.body) }}</div></div>
</fieldset>
<fieldset><legend>Publishing</legend>{{ form_row(form.status) }}{{ form_row(form.scheduledAt) }}{{ form_row(form.scheduledUnpublishAt) }}{{ form_row(form.featured) }}{{ form_row(form.pinned) }}{{ form_row(form.unlisted) }}</fieldset>
<fieldset><legend>SEO & Sharing</legend>{{ form_row(form.seoTitle) }}{{ form_row(form.seoDescription) }}{{ form_row(form.canonicalUrl) }}{{ form_row(form.noIndex) }}</fieldset><button type="submit">Speichern</button>{{ form_end(form) }}
{% if entry is defined %}<hr><div class="top-actions"><form method="post" action="{{ path('app_admin_content_duplicate',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('duplicate-content-'~entry.id) }}"><button>Als Entwurf duplizieren</button></form>{% if entry.status!='trashed' %}<form method="post" action="{{ path('app_admin_content_trash',{id:entry.id}) }}" onsubmit="return confirm('In den Papierkorb verschieben?')"><input type="hidden" name="_token" value="{{ csrf_token('trash-content-'~entry.id) }}"><button class="text-danger">Papierkorb</button></form>{% else %}<form method="post" action="{{ path('app_admin_content_restore_trash',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('restore-trash-content-'~entry.id) }}"><button>Wiederherstellen</button></form>{% endif %}</div>{% endif %}
</main>{% endblock %}
