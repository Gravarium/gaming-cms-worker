{% extends 'base.html.twig' %}{% block title %}Editorial Workspace | Gaming CMS{% endblock %}{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><nav class="top-actions"><a class="button-link" href="{{ path('app_admin_content_new') }}">Neuer Inhalt</a><a href="{{ path('app_admin_content_release_index') }}">Releases</a><a href="{{ path('app_admin_content_tag_index') }}">Tags</a><a href="{{ path('app_admin_category_index') }}">Kategorien</a></nav></header><main class="dashboard"><p class="eyebrow">Administration</p><h1>Editorial Workspace</h1>{% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}{% for message in app.flashes('error') %}<div class="notice text-danger">{{ message }}</div>{% endfor %}<form method="get" class="content-form" role="search"><label>Suche <input name="q" value="{{ filters.q }}" placeholder="Titel, Slug, Kurztext oder Tag"></label><label>Status <select name="status"><option value="">Alle</option>{% for value,label in {'draft':'Entwurf','review':'Zur Freigabe','scheduled':'Geplant','published':'Veröffentlicht','archived':'Archiviert','trashed':'Papierkorb'} %}<option value="{{ value }}" {{ filters.status==value?'selected' }}>{{ label }}</option>{% endfor %}</select></label><label>Typ <select name="type"><option value="">Alle</option><option value="news" {{ filters.type=='news'?'selected' }}>News</option><option value="page" {{ filters.type=='page'?'selected' }}>Seite</option></select></label><label>Kategorie <select name="category"><option value="">Alle</option>{% for category in categories %}<option value="{{ category.slug }}" {{ filters.category==category.slug?'selected' }}>{{ category.displayName }}</option>{% endfor %}</select></label><label>Tag <select name="tag"><option value="">Alle</option>{% for tag in tags %}<option value="{{ tag.slug }}" {{ filters.tag==tag.slug?'selected' }}>#{{ tag.name }}</option>{% endfor %}</select></label><button>Filtern</button></form>{% set statusLabels={'draft':'Entwurf','review':'Zur Freigabe','scheduled':'Geplant','published':'Veröffentlicht','archived':'Archiviert','trashed':'Papierkorb'} %}<form method="post" action="{{ path('app_admin_content_bulk') }}"><input type="hidden" name="_token" value="{{ csrf_token('content-bulk') }}"><div class="top-actions"><select name="action" required><option value="">Bulk-Aktion</option><option value="review">Zur Freigabe</option><option value="draft">Entwurf</option><option value="archive">Archivieren</option><option value="feature">Highlight an</option><option value="unfeature">Highlight aus</option><option value="pin">Anheften</option><option value="unpin">Lösen</option><option value="trash">Papierkorb</option></select><button>Ausführen</button></div><div class="table-wrap"><table><thead><tr><th></th><th>Titel</th><th>Typ</th><th>Status</th><th>Signale</th><th>Geändert</th><th>Aktionen</th></tr></thead><tbody>{% for entry in entries %}<tr><td><input type="checkbox" name="ids[]" value="{{ entry.id }}" aria-label="{{ entry.title }} auswählen"></td><td><strong>{{ entry.title }}</strong>{% if entry.subtitle %}<small>{{ entry.subtitle }}</small>{% endif %}</td><td>{{ entry.type=='news'?'News':'Seite' }}</td><td><span class="status {{ entry.published?'status-ready':'' }}">{{ statusLabels[entry.status]??entry.status }}</span>{% if entry.scheduledAt %}<small>Start: {{ entry.scheduledAt|date('d.m.Y H:i') }}</small>{% endif %}{% if entry.scheduledUnpublishAt %}<small>Ende: {{ entry.scheduledUnpublishAt|date('d.m.Y H:i') }}</small>{% endif %}</td><td>{% if entry.pinned %}📌{% endif %}{% if entry.featured %}★{% endif %}{% if entry.unlisted %} verborgen{% endif %}{% if entry.noIndex %} noindex{% endif %}</td><td>{{ entry.updatedAt|date('d.m.Y H:i') }}</td><td class="row-actions"><a href="{{ path('app_admin_content_edit',{id:entry.id}) }}">Bearbeiten</a><a href="{{ path('app_admin_content_preview',{id:entry.id}) }}" target="_blank" rel="noopener">Vorschau</a><a href="{{ path('app_admin_content_history',{id:entry.id}) }}">Versionen</a>{% if entry.status=='trashed' %}<form method="post" action="{{ path('app_admin_content_restore_trash',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('restore-trash-content-'~entry.id) }}"><button>Restore</button></form><form method="post" action="{{ path('app_admin_content_purge',{id:entry.id}) }}" onsubmit="return confirm('Endgültig löschen?')"><input type="hidden" name="_token" value="{{ csrf_token('purge-content-'~entry.id) }}"><button class="text-danger">Endgültig löschen</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="7">Keine passenden Inhalte vorhanden.</td></tr>{% endfor %}</tbody></table></div></form></main>{% endblock %}
