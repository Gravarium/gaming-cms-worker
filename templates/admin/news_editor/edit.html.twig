{% extends 'base.html.twig' %}
{% block title %}News bearbeiten | Gaming CMS{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('news_editor/editor.css') }}">{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><nav class="top-actions"><a href="{{ path('app_admin_news_editor_index') }}">News-Redaktion</a><a href="{{ path('app_admin_content_edit',{id:entry.id}) }}">Artikeldaten</a><a href="{{ path('app_admin_news_editor_history',{id:entry.id}) }}">Versionen</a><a href="{{ path('app_admin_content_index') }}">Inhalte</a></nav></header>
<main class="news-editor-shell" id="news-editor" data-preview-url="{{ path('app_admin_news_editor_preview',{id:entry.id}) }}" data-autosave-url="{{ path('app_admin_news_editor_autosave',{id:entry.id}) }}" data-media-url="{{ path('app_admin_news_editor_media',{id:entry.id}) }}" data-snippets-url="{{ path('app_admin_news_editor_snippets') }}" data-snippets-csrf="{{ csrf_token('news-editor-snippets') }}" data-csrf="{{ csrf_token('news-editor-'~entry.id) }}">
    <p class="eyebrow">News-Redaktion</p><h1>{{ entry.title }}</h1>
    <p class="muted">{{ entry.status == 'review' ? 'In Prüfung' : 'Entwurf' }} · Änderungen werden erst nach dem Speichern als Revision übernommen.</p>
    {% for message in app.flashes('success') %}<div class="notice" role="status">{{ message }}</div>{% endfor %}
    {% if error %}<div class="notice" role="alert">{{ error }}</div>{% endif %}
    <div class="news-editor-toolbar" role="toolbar" aria-label="Artikel formatieren">
        <button type="button" data-command="bold" aria-label="Fett">Fett</button><button type="button" data-command="italic" aria-label="Kursiv">Kursiv</button><button type="button" data-command="underline" aria-label="Unterstreichen">U</button><button type="button" data-command="strikeThrough" aria-label="Durchstreichen">S</button><button type="button" data-command="inlineCode">Inline-Code</button><button type="button" data-command="removeFormat">Formatierung entfernen</button><button type="button" data-command="link">Link</button><button type="button" data-command="unlink">Link entfernen</button>
        <button type="button" data-add="paragraph">Absatz</button><button type="button" data-add="heading">Überschrift</button><button type="button" data-add="quote">Zitat</button><button type="button" data-add="list">Liste</button><button type="button" data-add="table">Tabelle</button><button type="button" data-add="callout">Infobox</button><button type="button" data-add="code">Code</button><button type="button" data-add="separator">Trennlinie</button><button type="button" data-add="media">Bild</button><button type="button" data-add="video">Video</button>
        <button type="button" data-command="undo">Rückgängig</button><button type="button" data-command="redo">Wiederholen</button><button type="button" id="news-editor-preview-button">Vorschau</button>
    </div>
    <section class="news-editor-find" aria-label="Artikel als Markdown übertragen">
        <h2>Artikel übertragen</h2>
        <label>Markdown-Datei <input id="news-editor-markdown-file" type="file" accept=".md,.markdown,.txt,text/markdown,text/plain"></label>
        <button type="button" id="news-editor-markdown-import">Datei importieren und Inhalt ersetzen</button>
        <button type="button" id="news-editor-markdown-export">Markdown herunterladen</button>
        <p class="muted">Import ersetzt den Artikelinhalt nach Bestätigung. Rückgängig ist im Editor möglich. Beim Export werden Bilder und Videos als lesbare Referenzen ausgegeben und müssen für eine erneute Veröffentlichung in der Mediathek ausgewählt werden.</p>
        <p id="news-editor-exchange-status" role="status" aria-live="polite"></p>
    </section>
    <section class="news-editor-find" aria-label="Im Artikel suchen und ersetzen"><label>Suchen <input id="news-editor-find" type="search" maxlength="200" autocomplete="off"></label><button type="button" id="news-editor-find-next">Nächster Treffer</button><label>Ersetzen durch <input id="news-editor-replace" type="text" maxlength="200" autocomplete="off"></label><button type="button" id="news-editor-replace-all">Alle ersetzen</button><span id="news-editor-find-result" role="status" aria-live="polite"></span></section>
    <nav class="news-editor-outline" aria-label="Artikelgliederung"><h2>Artikelgliederung</h2><div id="news-editor-outline"></div></nav>
    <section class="news-editor-snippets" aria-labelledby="news-editor-snippets-heading">
        <h2 id="news-editor-snippets-heading">Persönliche Blockbibliothek</h2>
        <div class="news-editor-snippet-controls"><label>Vorlagenname <input id="news-editor-snippet-name" type="text" maxlength="80" autocomplete="off"></label><button type="button" id="news-editor-snippet-save">Aktiven Block speichern</button><label>Vorlagen durchsuchen <input id="news-editor-snippet-search" type="search" maxlength="80" autocomplete="off"></label></div>
        <p class="muted">Vorlagen sind nur für dein Benutzerkonto sichtbar. Einfügen setzt eine Kopie nach dem aktiven Block.</p>
        <p id="news-editor-snippet-status" role="status" aria-live="polite"></p>
        <div id="news-editor-snippet-list" class="news-editor-snippet-list"></div>
    </section>
    <section class="news-editor-readiness" id="news-editor-readiness" aria-labelledby="news-editor-readiness-heading" aria-busy="false" data-url="{{ path('app_admin_news_editor_readiness',{id:entry.id}) }}" data-csrf="{{ csrf_token('news-editor-'~entry.id) }}">
        <h2 id="news-editor-readiness-heading">Veröffentlichungscheck</h2>
        <p class="muted">Prüft den aktuellen, noch nicht gespeicherten Text. Das Audit ist unverbindlich und ändert oder speichert den Entwurf nicht.</p>
        <button type="button" data-readiness-refresh>Prüfung aktualisieren</button>
        <p data-readiness-status role="status" aria-live="polite" aria-atomic="true">Noch nicht geprüft.</p>
        <div data-readiness-summary></div>
        <div data-readiness-results role="region" aria-label="Prüfergebnisse"></div>
    </section>
    <form method="post" id="news-editor-form" novalidate>
        <input type="hidden" name="_token" value="{{ csrf_token('news-editor-'~entry.id) }}">
        <input type="hidden" name="updatedAt" value="{{ entry.updatedAt|date('c') }}">
        <input type="hidden" name="documentHash" value="{{ documentHash }}">
        <textarea name="document" id="news-editor-document" hidden>{{ document }}</textarea>
        <div id="news-editor-blocks" class="news-editor-blocks" aria-label="Artikelinhalt"></div>
        <p id="news-editor-status" role="status" aria-live="polite"></p>
        <div class="news-editor-actions"><button type="submit">Artikelentwurf speichern</button>{% if entry.status == 'draft' %}<button type="submit" formaction="{{ path('app_admin_news_editor_submit_review',{id:entry.id}) }}">Speichern und zur Freigabe einreichen</button>{% else %}<button type="submit" formaction="{{ path('app_admin_news_editor_review_decision',{id:entry.id,decision:'return-draft'}) }}">Änderungen speichern und zur Überarbeitung zurückgeben</button><button type="submit" formaction="{{ path('app_admin_news_editor_review_decision',{id:entry.id,decision:'publish'}) }}" onclick="return confirm('Diesen News-Artikel jetzt öffentlich veröffentlichen?')">Änderungen speichern und jetzt veröffentlichen</button>{% endif %}<span id="news-editor-count" class="muted"></span></div>
    </form>
    <div class="news-editor-actions" aria-label="Entwurfsaktionen">
        <form method="post" action="{{ path('app_admin_news_editor_duplicate',{id:entry.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('news-editor-duplicate-'~entry.id) }}"><input type="hidden" name="updatedAt" value="{{ entry.updatedAt|date('c') }}"><input type="hidden" name="documentHash" value="{{ documentHash }}"><button type="submit">Als neuen Entwurf duplizieren</button></form>
        <form method="post" action="{{ path('app_admin_news_editor_trash',{id:entry.id}) }}" onsubmit="return confirm('Diesen News-Entwurf in den Papierkorb verschieben?')"><input type="hidden" name="_token" value="{{ csrf_token('news-editor-trash-'~entry.id) }}"><input type="hidden" name="updatedAt" value="{{ entry.updatedAt|date('c') }}"><input type="hidden" name="documentHash" value="{{ documentHash }}"><button type="submit" class="text-danger">In den Papierkorb</button></form>
    </div>
    <section class="news-editor-media-picker" id="news-editor-media-picker" hidden aria-label="Bild auswählen">
        <h2>Bild aus der Mediathek auswählen</h2>
        <label>Suche <input id="news-editor-media-search" type="search" maxlength="80" autocomplete="off"></label>
        <button type="button" id="news-editor-media-search-button">Suchen</button>
        <button type="button" id="news-editor-media-close">Schließen</button>
        <p id="news-editor-media-message" role="status"></p>
        <div id="news-editor-media-results" class="news-editor-media-results"></div>
    </section>
    <section class="news-editor-preview" aria-label="Artikelvorschau"><h2>Vorschau</h2><div id="news-editor-preview"></div></section>
</main>
<script type="module" src="{{ asset('news_editor/editor.js') }}"></script>
{% endblock %}
