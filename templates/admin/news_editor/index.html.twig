{% extends 'base.html.twig' %}
{% block title %}News-Redaktion | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar"><a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a><nav class="top-actions"><a href="{{ path('app_admin_content_new') }}">Neue News anlegen</a><a href="{{ path('app_admin_content_index') }}">Alle Inhalte</a></nav></header>
<main class="dashboard">
    <p class="eyebrow">News-Redaktion</p>
    <h1>Artikel im visuellen Editor</h1>
    <p class="muted">Entwürfe und Beiträge in Prüfung. Veröffentlichte Artikel zuerst als Entwurf wiederherstellen.</p>
    <div class="table-wrap"><table>
        <thead><tr><th>Titel</th><th>Status</th><th>Geändert</th><th>Aktion</th></tr></thead>
        <tbody>
        {% for entry in entries %}<tr>
            <td>{{ entry.title }}</td><td>{{ entry.status == 'review' ? 'In Prüfung' : 'Entwurf' }}</td>
            <td>{{ entry.updatedAt|date('d.m.Y H:i') }}</td>
            <td><a href="{{ path('app_admin_news_editor',{id:entry.id}) }}">Im Editor öffnen</a></td>
        </tr>{% else %}<tr><td colspan="4">Derzeit keine bearbeitbaren News vorhanden.</td></tr>{% endfor %}
        </tbody>
    </table></div>
</main>
{% endblock %}
