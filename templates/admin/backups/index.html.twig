{% extends 'base.html.twig' %}
{% block title %}Backup-Bestand | Gaming CMS{% endblock %}
{% block body %}
<header class="topbar">
    <a class="brand" href="{{ path('app_admin_dashboard') }}">Gaming CMS</a>
    <nav class="top-actions">
        <a class="button-link" href="{{ path('app_admin_connector_index') }}">Externe Ziele</a>
        <a class="button-link button-secondary" href="{{ path('app_admin_dashboard') }}">Übersicht</a>
    </nav>
</header>
<main class="dashboard">
    <p class="eyebrow">Datensicherung</p>
    <h1>Backup-Bestand und Wiederherstellungsbereitschaft</h1>
    <p class="muted">Nur bereinigte Bestands- und Prüfdaten werden angezeigt. Datenbankzugänge, Schlüssel und Speicherpfade bleiben verborgen.</p>

    {% if not inventory_available %}
        <article class="panel">
            <h2>Backup-Speicher nicht lesbar</h2>
            <p>Der Webprozess hat keinen lesenden Zugriff. Die automatische Serversicherung kann trotzdem unabhängig funktionieren.</p>
        </article>
    {% elseif inventory_total == 0 %}
        <article class="panel">
            <h2>Noch kein lokales Backup gefunden</h2>
            <p>Nach dem nächsten erfolgreichen Backup-Lauf erscheint der Bestand hier.</p>
        </article>
    {% else %}
        <article class="panel">
            <p class="eyebrow">Wiederherstellungsbereitschaft</p>
            <h2>{{ inventory_total }} Backup{{ inventory_total == 1 ? '' : 's' }} im Bestand</h2>
            {% if latest_backup %}
                <p>
                    Neuestes Backup: <strong>{{ latest_backup.createdAt|date('d.m.Y H:i', 'UTC') }} UTC</strong><br>
                    Vollständige Prüfung:
                    {% if latest_status %}
                        <span class="status {{ latest_status.successful ? 'status-ready' : 'status-disabled' }}">{{ latest_status.successful ? 'Erfolgreich' : 'Fehlgeschlagen' }}</span>
                    {% else %}
                        <span class="status status-disabled">Noch nicht protokolliert</span>
                    {% endif %}
                </p>
            {% endif %}
            <p class="muted">Eine echte Wiederherstellung bleibt absichtlich ein bestätigter Servervorgang mit separater Zieldatenbank. Diese Seite verändert keine Daten.</p>
        </article>

        <form method="get" action="{{ path('app_admin_backup_index') }}" class="panel" role="search" aria-label="Backup-Bestand filtern">
            <div>
                <label for="backup-query">Backup-ID oder Revision</label>
                <input id="backup-query" type="search" name="q" value="{{ query }}" maxlength="80" autocomplete="off">
            </div>
            <div>
                <label for="backup-status">Prüfstatus</label>
                <select id="backup-status" name="status">
                    <option value="all" {{ verification_filter == 'all' ? 'selected' : '' }}>Alle</option>
                    <option value="successful" {{ verification_filter == 'successful' ? 'selected' : '' }}>Erfolgreich geprüft</option>
                    <option value="failed" {{ verification_filter == 'failed' ? 'selected' : '' }}>Prüfung fehlgeschlagen</option>
                    <option value="unchecked" {{ verification_filter == 'unchecked' ? 'selected' : '' }}>Noch nicht geprüft</option>
                </select>
            </div>
            <button type="submit">Filter anwenden</button>
            <a class="button-link button-secondary" href="{{ path('app_admin_backup_index') }}">Zurücksetzen</a>
        </form>

        <p class="muted" role="status">
            {% if total_backups > 0 %}
                Treffer {{ first_result }}–{{ last_result }} von {{ total_backups }} · Seite {{ current_page }} von {{ total_pages }}
            {% else %}
                Keine Treffer für diese Suche und diesen Prüfstatus.
            {% endif %}
        </p>

        {% if backups is not empty %}
            <section class="dashboard-grid" aria-label="Backup-Einträge">
                {% for backup in backups %}
                    {% set status = verification_statuses[backup.id] ?? null %}
                    <article class="panel">
                        <p class="eyebrow">{{ backup.createdAt|date('d.m.Y H:i', 'UTC') }} UTC</p>
                        <h2>{{ backup.id }}</h2>
                        <p>
                            Größe: {{ (backup.bytes / 1048576)|number_format(2, ',', '.') }} MiB<br>
                            Revision: {{ backup.revision|slice(0, 12) }}
                        </p>
                        {% if status %}
                            <p>
                                <span class="status {{ status.successful ? 'status-ready' : 'status-disabled' }}">{{ status.successful ? 'Vollständig geprüft' : 'Prüfung fehlgeschlagen' }}</span><br>
                                <span class="muted">{{ status.checkedAt|date('d.m.Y H:i', 'UTC') }} UTC</span>
                            </p>
                        {% else %}
                            <p><span class="status status-disabled">Noch keine protokollierte Prüfung</span></p>
                        {% endif %}
                        {% if backup.objectStorage == 'skipped_requires_external_backup' %}
                            <p class="text-danger">Externer Objektspeicher ist nicht in diesem Backup enthalten.</p>
                        {% endif %}
                    </article>
                {% endfor %}
            </section>
        {% endif %}

        {% if total_pages > 1 %}
            <nav aria-label="Backup-Bestand Seiten">
                {% if current_page > 1 %}
                    <a class="button-link button-secondary" href="{{ path('app_admin_backup_index', {q: query, status: verification_filter, page: current_page - 1}) }}">Vorherige Seite</a>
                {% endif %}
                <span>Seite {{ current_page }} von {{ total_pages }}</span>
                {% if current_page < total_pages %}
                    <a class="button-link button-secondary" href="{{ path('app_admin_backup_index', {q: query, status: verification_filter, page: current_page + 1}) }}">Nächste Seite</a>
                {% endif %}
            </nav>
        {% endif %}
    {% endif %}
</main>
{% endblock %}
