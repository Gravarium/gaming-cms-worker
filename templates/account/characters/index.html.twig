{% extends 'base.html.twig' %}
{% block title %}Meine Spielcharaktere{% endblock %}
{% block body %}
<main class="container">
    <p><a href="{{ path('app_account_home') }}">← Mein Konto</a> · <a href="{{ path('app_character_index') }}">Öffentliche Charaktere</a></p>
    <h1>Meine Spielcharaktere</h1>
    <p>Hier verwaltest du deine eigenen Accounts und privaten Charakterprofile. Neue Profile werden nicht automatisch veröffentlicht.</p>
    {% for message in app.flashes('success') %}<div class="notice">{{ message }}</div>{% endfor %}
    <p><a class="button-link" href="{{ path('app_character_owner_account_new') }}">Account anlegen</a>
       <a class="button-link" href="{{ path('app_character_owner_profile_new') }}">Charakter anlegen</a></p>
    <section aria-labelledby="accounts-heading">
        <h2 id="accounts-heading">Meine Accounts</h2>
        {% for account in accounts %}
            <article class="panel">
                <h3>{{ account.displayName }} · {{ account.game.name }}</h3>
                <p>{{ account.source == 'imported' ? 'Importierter Account' : 'Manueller Account' }}</p>
                <a href="{{ path('app_character_owner_account_edit', {id: account.id}) }}">Anzeigename bearbeiten</a>
                <form method="post" action="{{ path('app_character_owner_account_delete', {id: account.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('character-owner-account-delete-' ~ account.id) }}">
                    <button type="submit">Account und seine Profile stilllegen</button>
                </form>
            </article>
        {% else %}
            <p>Noch keine Charakteraccounts vorhanden.</p>
        {% endfor %}
    </section>
    <section aria-labelledby="profiles-heading">
        <h2 id="profiles-heading">Meine Profile</h2>
        {% for profile in profiles %}
            <article class="panel">
                <h3>{{ profile.name }} · {{ profile.game.name }}</h3>
                <p>{{ profile.account.displayName }} · {{ profile.publiclyVisible ? 'Öffentlich' : 'Privat' }}</p>
                {% if profile.manual %}
                    <a href="{{ path('app_character_owner_profile_edit', {id: profile.id}) }}">Profil bearbeiten</a>
                {% else %}
                    <p>Importierte Felder werden durch die Importquelle verwaltet.</p>
                {% endif %}
                <form method="post" action="{{ path('app_character_owner_profile_delete', {id: profile.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('character-owner-profile-delete-' ~ profile.id) }}">
                    <button type="submit">Profil stilllegen</button>
                </form>
            </article>
        {% else %}
            <p>Noch keine Charakterprofile vorhanden.</p>
        {% endfor %}
    </section>
</main>
{% endblock %}
