{% extends 'base.html.twig' %}
{% block title %}{{ profile ? 'Charakterprofil bearbeiten' : 'Charakterprofil anlegen' }}{% endblock %}
{% block body %}
<main class="form-page">
    <p><a href="{{ path('app_character_owner_index') }}">← Meine Spielcharaktere</a></p>
    <h1>{{ profile ? 'Charakterprofil bearbeiten' : 'Privates Charakterprofil anlegen' }}</h1>
    <p>Dieses Formular veröffentlicht keine Felder und ändert keine Freigaben.</p>
    {% if error %}<div class="alert" role="alert">{{ error }}</div>{% endif %}
    {% if not profile and accounts is empty %}
        <p>Lege zuerst einen Account für ein aktives Spiel an.</p>
        <a href="{{ path('app_character_owner_account_new') }}">Account anlegen</a>
    {% else %}
        <form method="post" class="form-stack">
            <input type="hidden" name="_token" value="{{ csrf_token(profile ? 'character-owner-profile-edit-' ~ profile.id : 'character-owner-profile-new') }}">
            {% if profile %}
                <p>{{ profile.account.displayName }} · {{ profile.game.name }}</p>
            {% else %}
                <label>Account
                    <select name="account_id" required>
                        <option value="">Account wählen</option>
                        {% for account in accounts %}
                            <option value="{{ account.id }}">{{ account.displayName }} · {{ account.game.name }}</option>
                        {% endfor %}
                    </select>
                </label>
            {% endif %}
            <label>Name<input name="name" maxlength="160" value="{{ values.name }}" required></label>
            <label>Server<input name="server" maxlength="120" value="{{ values.server }}"></label>
            <label>Region<input name="region" maxlength="80" value="{{ values.region }}"></label>
            <label>Klasse<input name="character_class" maxlength="100" value="{{ values.character_class }}"></label>
            <label>Rolle<input name="role" maxlength="80" value="{{ values.role }}"></label>
            <label>Stufe<input name="level" type="number" min="1" max="10000" value="{{ values.level }}"></label>
            <button type="submit">Speichern</button>
        </form>
    {% endif %}
</main>
{% endblock %}
