{% extends 'base.html.twig' %}
{% block title %}{% if category %}{{ category.name }}{% elseif tag %}#{{ tag.name }}{% else %}News{% endif %} | {{ site.siteName }}{% endblock %}{% block head_meta %}<link rel="alternate" type="application/rss+xml" title="News RSS" href="{{ absolute_url(path('app_news_feed_rss')) }}">{% endblock %}
{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_home') }}">{{ site.siteName }}</a><nav class="top-actions"><a href="{{ path('app_content_search') }}">Suche</a><a href="{{ path('app_news_feed_rss') }}">RSS</a></nav></header><main class="dashboard"><p class="eyebrow">News</p><h1>{% if category %}Kategorie: {{ category.displayName }}{% elseif tag %}Tag: #{{ tag.name }}{% else %}Aktuelles{% endif %}</h1>{% if category and category.description %}<p class="muted">{{ category.description }}</p>{% endif %}{% if tag and tag.description %}<p class="muted">{{ tag.description }}</p>{% endif %}
{% if featured|default([])|length %}<section><h2>Highlights</h2><div class="news-grid">{% for entry in featured %}<article class="card"><p class="eyebrow">Highlight</p><h3><a href="{{ path('app_news_show',{slug:entry.slug}) }}">{{ entry.title }}</a></h3>{% if entry.excerpt %}<p>{{ entry.excerpt }}</p>{% endif %}</article>{% endfor %}</div></section>{% endif %}
<p class="muted">{{ total }} Beiträge</p><div class="news-grid">{% for entry in entries %}<article class="card"><p class="news-date">{{ entry.publishedAt|date('d.m.Y H:i') }}{% if entry.category %} · {{ entry.category.name }}{% endif %}</p><h2><a href="{{ path('app_news_show',{slug:entry.slug}) }}">{{ entry.title }}</a></h2>{% if entry.subtitle %}<p><strong>{{ entry.subtitle }}</strong></p>{% endif %}{% if entry.excerpt %}<p>{{ entry.excerpt }}</p>{% endif %}{% if entry.tags|length %}<p>{% for tagItem in entry.tags %}<a href="{{ path('app_news_tag',{slug:tagItem.slug}) }}">#{{ tagItem.name }}</a>{% if not loop.last %} · {% endif %}{% endfor %}</p>{% endif %}</article>{% else %}<p>Keine veröffentlichten Beiträge vorhanden.</p>{% endfor %}</div>
{% if pages>1 %}<nav class="pagination" aria-label="Seitennavigation">{% if page>1 %}<a href="{{ app.request.pathInfo }}?page={{ page-1 }}">← Neuer</a>{% endif %}<span>Seite {{ page }} von {{ pages }}</span>{% if page<pages %}<a href="{{ app.request.pathInfo }}?page={{ page+1 }}">Älter →</a>{% endif %}</nav>{% endif %}</main>{% endblock %}
