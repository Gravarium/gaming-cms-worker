{% extends 'base.html.twig' %}{% block title %}Suche | {{ site.siteName }}{% endblock %}{% block head_meta %}<meta name="robots" content="noindex,follow">{% endblock %}{% block body %}<header class="topbar"><a class="brand" href="{{ path('app_home') }}">{{ site.siteName }}</a><a href="{{ path('app_news_index') }}">News</a></header><main class="dashboard"><p class="eyebrow">Inhalte</p><h1>Suche</h1><form method="get" role="search" class="content-form">
<label for="content-search-query">Suchbegriff <input id="content-search-query" name="q" value="{{ query }}" minlength="2" maxlength="100" required></label>
<label for="content-search-type">Inhaltstyp <select id="content-search-type" name="type"><option value="">Alle Inhalte</option><option value="news"{% if type == 'news' %} selected{% endif %}>News</option><option value="page"{% if type == 'page' %} selected{% endif %}>Seiten</option></select></label>
<label for="content-search-category">Kategorie <select id="content-search-category" name="category"><option value="">Alle Kategorien</option>{% for categoryOption in categories %}<option value="{{ categoryOption.slug }}"{% if category and category.slug == categoryOption.slug %} selected{% endif %}>{{ categoryOption.displayName }}</option>{% endfor %}</select></label>
<button>Suchen</button><a href="{{ path('app_content_search') }}">Alle Filter löschen</a>
</form>{% if query|length>=2 %}<p class="muted">{{ entries|length }} Treffer für „{{ query }}“</p>{% endif %}<div class="news-grid">{% for entry in entries %}<article class="card"><p class="eyebrow">{{ entry.type=='news'?'News':'Seite' }}</p><h2><a href="{{ entry.type=='news' ? path('app_news_show',{slug:entry.slug}) : path('app_page_show',{slug:entry.slug}) }}">{{ entry.title }}</a></h2>{% if entry.excerpt %}<p>{{ entry.excerpt }}</p>{% endif %}</article>{% endfor %}</div></main>{% endblock %}
