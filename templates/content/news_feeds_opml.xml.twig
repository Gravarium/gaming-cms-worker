<?xml version="1.0" encoding="UTF-8"?>
<opml version="2.0"><head><title>News Feeds</title></head><body><outline text="News categories" title="News categories">{% for feed in categoryFeeds %}<outline type="rss" text="{{ feed.title|e('html') }}" title="{{ feed.title|e('html') }}" xmlUrl="{{ feed.feed_url|e('html') }}" htmlUrl="{{ feed.archive_url|e('html') }}" />{% endfor %}</outline><outline text="News tags" title="News tags">{% for feed in tagFeeds %}<outline type="rss" text="{{ feed.title|e('html') }}" title="{{ feed.title|e('html') }}" xmlUrl="{{ feed.feed_url|e('html') }}" htmlUrl="{{ feed.archive_url|e('html') }}" />{% endfor %}</outline></body></opml>
