<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:news="http://www.google.com/schemas/sitemap-news/0.9">{% for entry in entries %}<url><loc>{{ absolute_url(path('app_news_show', {slug: entry.slug}))|e('html') }}</loc><news:news><news:publication><news:name>{{ site_settings().siteName|e('html') }}</news:name><news:language>{{ language|lower|e('html') }}</news:language></news:publication><news:publication_date>{{ entry.publishedAt|date('c') }}</news:publication_date><news:title>{{ entry.title|e('html') }}</news:title></news:news><lastmod>{{ entry.updatedAt|date('c') }}</lastmod></url>{% endfor %}</urlset>
