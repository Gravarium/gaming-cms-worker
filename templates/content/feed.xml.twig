<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"><channel><title>{{ site.siteName|e('html') }} News</title><link>{{ absolute_url(path('app_news_index'))|e('html') }}</link><description>{{ site.description|e('html') }}</description>{% for entry in entries %}<item><title>{{ entry.title|e('html') }}</title><link>{{ absolute_url(path('app_news_show',{slug:entry.slug}))|e('html') }}</link><guid isPermaLink="true">{{ absolute_url(path('app_news_show',{slug:entry.slug}))|e('html') }}</guid>{% if entry.publishedAt %}<pubDate>{{ entry.publishedAt|date('r') }}</pubDate>{% endif %}<description>{{ (entry.excerpt ?: entry.subtitle ?: entry.title)|e('html') }}</description>{% for tag in entry.tags %}<category>{{ tag.name|e('html') }}</category>{% endfor %}</item>{% endfor %}</channel></rss>
