{% extends 'video_player_choice/layout.html.twig' %}
{% block heading %}Branding-Vorschau: {{ video.title }}{% endblock %}
{% block stylesheets %}{{ parent() }}<link rel="stylesheet" href="{{ asset('video_player_branding/preview.css') }}">{% endblock %}
{% block choice %}
<p>Testvorschau für öffentlich sichtbare, freigegebene Quellen. Die Auswahl wird nicht gespeichert. Erst „Vorschau laden“ stellt eine Verbindung zur Quelle her.</p>
<p><a href="{{ path('app_video_player_choice_video', {slug: video.slug}) }}">Zur Player-Auswahl</a></p>
{% for source in sources %}
<section class="panel branding-form"><h2>{{ source.label }}</h2>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('video-branding-' ~ video.id) }}"><input type="hidden" name="source" value="{{ source.id }}">
{% if source.direct %}
<label>Branding <select name="branding"><option value="off">Ohne Branding</option><option value="own"{% if selected == source.id and settings and settings.mode == 'own' %} selected{% endif %}>Eigene Kennzeichnung</option></select></label>
<label>Text <input name="brand_label" value="{{ selected == source.id and settings ? settings.label : 'Gaming CMS' }}" maxlength="40" required></label>
<label>Darstellung <select name="brand_color"><option value="light">Hell</option><option value="dark"{% if selected == source.id and settings and settings.color == 'dark' %} selected{% endif %}>Dunkel</option></select></label>
<label>Position <select name="brand_position"><option value="top-right">Oben rechts</option><option value="top-left"{% if selected == source.id and settings and settings.position == 'top-left' %} selected{% endif %}>Oben links</option><option value="bottom-right"{% if selected == source.id and settings and settings.position == 'bottom-right' %} selected{% endif %}>Unten rechts</option><option value="bottom-left"{% if selected == source.id and settings and settings.position == 'bottom-left' %} selected{% endif %}>Unten links</option></select></label>
{% else %}<input type="hidden" name="branding" value="off"><p>Anbieter-Player: dessen Kennzeichnung bleibt unverändert.</p>{% endif %}
<button type="submit">Vorschau laden</button></form></section>
{% else %}<p>Für dieses Video ist keine verfügbare Quelle hinterlegt.</p>{% endfor %}
{% if playback %}<section class="panel branding-preview" aria-label="Videovorschau"><h2>Vorschau</h2>
{% if playback.mode in ['video', 'hls'] %}
<div class="branding-frame" data-branding-frame>
<video controls playsinline preload="none" data-workspace-player data-mode="{{ playback.mode }}" data-source="{{ playback.url }}" aria-label="{{ video.title }}"></video>
{% if settings.mode == 'own' %}<span class="branding-badge branding-{{ settings.color }} branding-{{ settings.position }}" aria-label="Eigene Kennzeichnung">{{ settings.label }}</span>{% endif %}
</div><p data-player-status role="status" aria-live="polite"></p>
<button type="button" data-branding-fullscreen>Vollbild der Vorschau</button>
{% elseif playback.mode == 'iframe' %}
<iframe src="{{ playback.url }}" title="{{ video.title }}" allow="autoplay; fullscreen; picture-in-picture; encrypted-media" allowfullscreen sandbox="allow-scripts allow-same-origin allow-presentation" referrerpolicy="strict-origin-when-cross-origin"></iframe>
<p>Für diesen Anbieter-Player gibt es hier keinen Branding-Schalter.</p>
{% else %}<p>Diese Quelle wird beim Anbieter geöffnet.</p>{% endif %}
<p><a href="{{ playback.url }}" target="_blank" rel="noopener noreferrer">Quelle separat öffnen</a></p></section>{% endif %}
<script type="module" src="{{ asset('video_workspace/player.js') }}"></script>
<script type="module" src="{{ asset('video_player_branding/preview.js') }}"></script>
{% endblock %}
