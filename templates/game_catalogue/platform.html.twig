{% extends 'base.html.twig' %}

{% block title %}{{ platform.name }}-Spiele | Game Hubs{% endblock %}

{% block body %}
<main class="content-shell">
    <header class="page-header">
        <p class="eyebrow">Spielekatalog · Plattform</p>
        <h1>{{ platform.name }}-Spiele</h1>
        <p>{{ total }} veröffentlichte Spiele mit verfügbaren Releases für {{ platform.name }}.</p>
        <a class="button-link button-secondary" href="{{ path('app_game_catalogue_platform_directory') }}">Alle Plattformen</a>
    </header>

    <section class="portal-cards" aria-label="Spiele für {{ platform.name }}">
        {% for entry in entries %}
            <article class="portal-card">
                <p class="portal-kicker">{{ entry.publisher ? entry.publisher.name : 'Publisher offen' }}</p>
                <h2><a href="{{ path('app_game_catalogue_show', {slug: entry.game.slug}) }}">{{ entry.game.name }}</a></h2>
                {% if entry.developer %}<p>{{ entry.developer }}</p>{% endif %}
                {% if entry.summary %}<p>{{ entry.summary }}</p>{% endif %}
                {% if entry.genres|length %}<p>{% for genre in entry.genres %}<span class="portal-tag">{{ genre.name }}</span> {% endfor %}</p>{% endif %}
            </article>
        {% else %}
            <p>Für diese Plattform sind aktuell keine Spiele verfügbar.</p>
        {% endfor %}
    </section>

    {% if totalPages > 1 %}
        <nav class="game-catalogue-pagination" aria-label="Plattformseiten">
            {% if page > 1 %}
                <a rel="prev" href="{{ path('app_game_catalogue_platform', {slug: platform.slug, page: page - 1}) }}">Vorherige</a>
            {% endif %}
            <span>Seite {{ page }} von {{ totalPages }}</span>
            {% if page < totalPages %}
                <a rel="next" href="{{ path('app_game_catalogue_platform', {slug: platform.slug, page: page + 1}) }}">Nächste</a>
            {% endif %}
        </nav>
    {% endif %}
</main>
{% endblock %}
